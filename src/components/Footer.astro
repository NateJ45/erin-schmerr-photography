---
// Foundation, edit with care
// Site footer: "the boutique close" (DESIGN.md, Components; 2026-11-20). Replaced the
// "end credits" footer of 2026-11-18.
//
// Warm paper, quiet, in four bands (styles: src/styles/chrome-footer.css):
//   1. Where next rows, when Site settings switch them on (card 191).
//   2. The invitation: a centred line in Instrument Serif with one italic word, a short
//      sentence and an outlined square "Book a session" button (the header button's label
//      and link). Left out on the page the button points to. The two lines are a DRAFT for
//      Erin to approve or rewrite (docs/PENDING.md).
//   3. Under a hairline: the site's pages as one stacked list at the left (Site settings >
//      Footer columns, else the top menu; the no-JS "Menu" link lands here), the newsletter
//      as a single underlined email field when Site settings switch it on (the site's own
//      NewsletterSignup, restyled), the places she works (Site settings service areas, each
//      with the business facts' address where it is in that town, else "Town, ST" from the
//      facts' state; never typed here), then Instagram and the other social links, email
//      and phone at the right.
//   4. "Tate" (the first word of the site name) set huge across the full width. It builds in
//      letter by letter the first time it scrolls into view: each glyph starts eroded by a
//      thick paper-coloured stroke that thins to nothing, so the letter grows out from its
//      spine (a CSS stand-in for the distance-field reveal on the reference). JavaScript arms
//      it only when IntersectionObserver exists, motion is allowed and the word is below the
//      fold; with JS off, under reduced motion, in print, or already on screen it is at rest.
//   5. The small print: copyright, privacy or the legal links, Studio, the optional credit.
//   6. The phone action bar (card 191), when this page has one.

import { site } from '@/data/site';
import { resolveSocialLinks, socialLabel, type SocialLink } from '@/lib/social-links';
import { ArrowUpRight } from 'lucide-react';
import CopyEmailButton from '@/components/CopyEmailButton.astro';
import NewsletterSignup from '@/components/NewsletterSignup';
import { getNavPages, getAllPageSlugs } from '@/lib/queries';
import { resolveSiteSettings, type RawChromeSettings } from '@/lib/siteSettings';
import { mergePageSwitches } from '@/lib/page-switches';
import { publicPath } from '@/lib/page-path';
import { placeLine } from '@/lib/place-line';
import { pickActionBar, whereNextRows } from '@/lib/wayfinding';
import WhereNext from '@/components/WhereNext.astro';
import ActionBar from '@/components/ActionBar.astro';
import { resolveBusinessFacts, todayBarLine, type RawBusinessFacts } from '@/lib/business-facts';
import ToConfirm from '@/components/business/ToConfirm.astro';
import '@/styles/chrome-footer.css';

interface NewsletterConfig {
  enabled?: boolean;
  heading?: string;
  blurb?: string;
  buttonLabel?: string;
  successMessage?: string;
  consentNote?: string;
  formActionUrl?: string | null;
  audienceId?: string | null;
}

interface Props {
  siteSettings?:
    | (RawChromeSettings & {
        title?: string;
        email?: string;
        phone?: string;
        state?: string | null;
        socialInstagram?: string;
        socialFacebook?: string;
        socialLinks?:
          { platform?: string | null; url?: string | null; label?: string | null }[] | null;
        serviceAreas?: string[];
        tagline?: string;
        footerCredit?: string;
        footerCreditUrl?: string;
        newsletter?: NewsletterConfig | null;
      })
    | null;
}

const { siteSettings } = Astro.props as Props;
const chrome = resolveSiteSettings(siteSettings);

const brandName = siteSettings?.title ?? site.name;
// The giant word: the first word of the brand's name ("Tate"), from brand.config.json
// through site.ts, the same source as the header wordmark.
const bigWord = site.name.trim().split(/\s+/)[0] ?? site.name;

const facts = resolveBusinessFacts(siteSettings as RawBusinessFacts | null | undefined);
const email = siteSettings?.email ?? '';
const phone = siteSettings?.phone ?? '';
const socialLinks: SocialLink[] = chrome.showFooterSocials ? resolveSocialLinks(siteSettings) : [];

// The invitation's button: the header button's label and link (Header.astro's default).
const book = {
  label: siteSettings?.headerCta?.label?.trim() ? chrome.headerCta.label : 'Book a session',
  href: chrome.headerCta.href,
};
const here = publicPath(Astro.url.pathname);
const showInvite = publicPath(book.href) !== here;

// The site's pages as ONE list: the editor's footer columns (with switched-on pages,
// card 187), else the top menu and the inquiry. Same href twice is drawn once.
const columns =
  chrome.footerColumns.length > 0
    ? mergePageSwitches([], chrome.footerColumns, await getNavPages()).footer
    : [
        {
          title: 'Pages',
          links: [
            ...chrome.headerNav.flatMap((item) =>
              item.kind === 'flat' ? [{ label: item.label, href: item.href }] : item.items,
            ),
            { label: book.label, href: book.href },
          ],
        },
      ];
const seen = new Set<string>();
const pages = columns
  .flatMap((col) => col.links)
  .filter((l) => (seen.has(l.href) ? false : (seen.add(l.href), true)));

// The places she works (Detroit's two-place column): each service area, with the business
// facts' street address under the town it is in, else "Cincinnati, OH" from the facts' state.
const areas = (siteSettings?.serviceAreas ?? []).map((a) => a.trim()).filter(Boolean);
const placeNames = areas.length > 0 ? areas : facts.address ? [facts.address.city] : [];
const places = placeNames.map((name) => {
  const addr =
    facts.address && facts.address.city.toLowerCase() === name.toLowerCase() ? facts.address : null;
  return {
    name,
    lines: addr ? addr.lines : [placeLine({ city: name, state: siteSettings?.state })],
    mapsUrl: addr?.mapsUrl ?? null,
    confirmed: addr ? addr.confirmed : true,
  };
});

const currentYear = new Date().getFullYear();
const LEGAL_LINKS = chrome.legalNav;
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

const whereNext = siteSettings?.whereNext?.length
  ? whereNextRows(siteSettings.whereNext, here, await getAllPageSlugs())
  : [];
const pickedBar = pickActionBar(siteSettings?.actionBars, here);
const actionBar =
  pickedBar && !pickedBar.text
    ? { ...pickedBar, text: todayBarLine(facts, new Date(), site.timeZone) }
    : pickedBar;
---

<footer id="site-footer" class="bq-footer bg-background text-foreground">
  {whereNext.length > 0 && <WhereNext rows={whereNext} />}

  {showInvite && (
    <section class="bq-invite" aria-labelledby="bq-invite-title">
      {/* DRAFT copy for Erin (docs/PENDING.md): she approves or rewrites both lines. */}
      <h2 id="bq-invite-title" class="bq-invite__title">
        A portrait made to be <em>kept</em>
      </h2>
      <p class="bq-invite__line">Tell me who it is for, and we will plan it together.</p>
      <a href={book.href} class="dk-button dk-button--line bq-invite__button">
        {book.label}
      </a>
    </section>
  )}

  <div class="bq-index" data-bq-rise>
    <div class="bq-index__lead">
      <nav aria-label="Footer">
        <ul class="bq-pages">
          {pages.map((link, i) => (
            <li>
              <a
                href={link.href}
                aria-current={publicPath(link.href) === here ? 'page' : undefined}
              >
                <span class="bq-rise" style={`--i:${i}`}>
                  <span>{link.label}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {siteSettings?.newsletter?.enabled && (
        <div class="bq-newsletter">
          <NewsletterSignup
            client:visible
            newsletter={siteSettings.newsletter}
            source="footer"
            idPrefix="footer-newsletter"
          />
        </div>
      )}
    </div>

    {places.length > 0 && (
      <ul class="bq-places" aria-label="Where she works">
        {places.map((p) => (
          <li class="bq-place">
            <p class="bq-place__name">
              <span class="bq-place__arrow" aria-hidden="true">
                →
              </span>
              {p.name}
            </p>
            <p class="bq-place__lines">
              {p.lines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
              <ToConfirm confirmed={p.confirmed} />
            </p>
            {p.mapsUrl && (
              <a class="bq-quiet" href={p.mapsUrl} target="_blank" rel="noopener noreferrer">
                Map
                <ArrowUpRight size={12} aria-hidden="true" />
              </a>
            )}
          </li>
        ))}
      </ul>
    )}

    {(socialLinks.length > 0 || email || phone) && (
      <ul class="bq-reach">
        {socialLinks.map((link, i) => (
          <li>
            <a class="bq-quiet" href={link.url} target="_blank" rel="noopener noreferrer">
              <span class="bq-rise" style={`--i:${i}`}>
                <span>{socialLabel(link)}</span>
              </span>
              <ArrowUpRight size={12} aria-hidden="true" />
            </a>
          </li>
        ))}
        {email && (
          <li>
            <CopyEmailButton email={email} variant="link" />
            <ToConfirm confirmed={facts.email?.confirmed} />
          </li>
        )}
        {phone && (
          <li>
            <a class="bq-quiet" href={facts.phone?.href ?? `tel:${phone}`}>
              {phone}
            </a>
            <ToConfirm confirmed={facts.phone?.confirmed} />
          </li>
        )}
      </ul>
    )}
  </div>

  {/* The giant name, a link home named in full. Letters build in on first view (script). */}
  <div class="bq-mark-wrap">
    <a href="/" class="bq-mark" data-bq-mark aria-label={`${site.name} home`}>
      <span class="bq-mark__word" aria-hidden="true">
        {[...bigWord].map((ch, i) => (
          <span class="bq-mark__l" style={`--i:${i}`}>
            {ch}
          </span>
        ))}
      </span>
    </a>
  </div>

  <div class="bq-small">
    <p>
      © {currentYear} {brandName}
    </p>
    {LEGAL_LINKS.length > 0 ? (
      LEGAL_LINKS.map((l) => <a href={l.href}>{l.label}</a>)
    ) : (
      <a href="/privacy/">Privacy policy</a>
    )}
    <a href="/studio" rel="nofollow">
      Studio
    </a>
    {siteCredit &&
      (siteCreditUrl ? (
        <a href={siteCreditUrl} target="_blank" rel="noopener noreferrer">
          {siteCredit}
        </a>
      ) : (
        <span>{siteCredit}</span>
      ))}
  </div>

  {actionBar && <ActionBar bar={actionBar} />}
</footer>

<script>
  // The footer's two entrances (chrome-footer.css), after the Vero reference: the wordmark's
  // letter build-in ([data-bq-mark]) and the page and social labels rising into their
  // clipped boxes ([data-bq-rise]). Each is armed only where it can play: motion allowed,
  // IntersectionObserver present, and the element still below the fold (one already on
  // screen stays at rest). Plays once, then the observer goes. Re-runs after a View
  // Transitions swap, which draws a fresh footer.
  function armMarks() {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const el of document.querySelectorAll<HTMLElement>('[data-bq-mark], [data-bq-rise]')) {
      if (el.dataset.build) continue;
      if (el.getBoundingClientRect().top < window.innerHeight) continue;
      el.dataset.build = 'armed';
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          el.dataset.build = 'on';
          io.disconnect();
        },
        { threshold: el.hasAttribute('data-bq-mark') ? 0.35 : 0.15 },
      );
      io.observe(el);
    }
  }
  armMarks();
  document.addEventListener('astro:page-load', armMarks);
</script>

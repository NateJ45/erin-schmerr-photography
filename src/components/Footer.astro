---
// Foundation, edit with care
// Site footer: "end credits" (DESIGN.md, Components; 2026-11-18).
//
// Set on paper and centred like the credits at the end of a film:
//   1. Where next rows and the newsletter, when Site settings switch them on (card 191).
//   2. The credits: "Photographs by Erin Schmerr", then "Starring" (the people credited on
//      her stories), "On location at" (the stories' places and credited venues) and "As
//      published in" (the press magazines), each a short list linking where the data has a
//      page (src/components/darkroom/chrome-data.ts). Then the site's pages, from Site
//      settings > Footer columns (or the top menu when there are none), two by two on a
//      phone. This list is also where the "Menu" button lands with JavaScript off.
//   3. "Booking sessions in Cincinnati and West Chester · 11:02 AM": the service areas and
//      her local time on site.timeZone. The build writes the zone's short name (EST); the
//      small script below swaps in the time, in a fixed-width box so nothing moves.
//   4. Email, phone and social links when Site settings has them, then the small print
//      (copyright, privacy or the legal links, Studio, the optional credit).
//   5. A huge "Tate" (the first word of the site name), cropped by the footer's bottom edge.
//   6. The phone action bar (card 191), when this page has one.
// Where the credits come into view they roll up a little on a CSS scroll-driven timeline
// (erin-motion.css); reduced motion, touch-free fallbacks and browsers without support
// show them still.

import { site } from '@/data/site';
import { resolveSocialLinks, socialLabel, type SocialLink } from '@/lib/social-links';
import { socialIcon } from '@/lib/social-icons';
import { Phone } from 'lucide-react';
import CopyEmailButton from '@/components/CopyEmailButton.astro';
import NewsletterSignup from '@/components/NewsletterSignup';
import { getNavPages, getAllPageSlugs } from '@/lib/queries';
import { resolveSiteSettings, type RawChromeSettings } from '@/lib/siteSettings';
import { mergePageSwitches } from '@/lib/page-switches';
import { publicPath } from '@/lib/page-path';
import { pickActionBar, whereNextRows } from '@/lib/wayfinding';
import WhereNext from '@/components/WhereNext.astro';
import ActionBar from '@/components/ActionBar.astro';
import { resolveBusinessFacts, todayBarLine, type RawBusinessFacts } from '@/lib/business-facts';
import ToConfirm from '@/components/business/ToConfirm.astro';
import { getDarkroomData, type ChromeCredit } from './darkroom/chrome-data';

interface NewsletterConfig {
  enabled?: boolean;
  heading?: string;
  blurb?: string;
  buttonLabel?: string;
  successMessage?: string;
  consentNote?: string;
  formActionUrl?: string | null;
  audienceId?: string | null;
}

interface Props {
  siteSettings?:
    | (RawChromeSettings & {
        title?: string;
        email?: string;
        phone?: string;
        socialInstagram?: string;
        socialFacebook?: string;
        socialLinks?:
          { platform?: string | null; url?: string | null; label?: string | null }[] | null;
        serviceAreas?: string[];
        tagline?: string;
        footerCredit?: string;
        footerCreditUrl?: string;
        newsletter?: NewsletterConfig | null;
      })
    | null;
}

const { siteSettings } = Astro.props as Props;
const chrome = resolveSiteSettings(siteSettings);

const brandName = siteSettings?.title ?? site.name;
// The photographer the credits roll for. Her name, not the business name.
const PHOTOGRAPHER = 'Erin Schmerr';
// The giant word at the foot: the first word of the site name ("Tate").
const bigWord = brandName.trim().split(/\s+/)[0] ?? brandName;

const facts = resolveBusinessFacts(siteSettings as RawBusinessFacts | null | undefined);
const email = siteSettings?.email ?? '';
const phone = siteSettings?.phone ?? '';
const socialLinks: SocialLink[] = chrome.showFooterSocials ? resolveSocialLinks(siteSettings) : [];

const { starring, locations, publishedIn } = await getDarkroomData();
const creditLines: { id: string; role: string; names: ChromeCredit[] }[] = [
  { id: 'credits-starring', role: 'Starring', names: starring },
  { id: 'credits-location', role: 'On location at', names: locations },
  { id: 'credits-published', role: 'As published in', names: publishedIn },
].filter((line) => line.names.length > 0);

// The site's pages: the editor's footer columns (with switched-on pages, card 187), else the
// top menu and the inquiry, so the no-JS "Menu" link always lands on every page.
const columns =
  chrome.footerColumns.length > 0
    ? mergePageSwitches([], chrome.footerColumns, await getNavPages()).footer
    : [
        {
          title: 'Pages',
          links: chrome.headerNav.flatMap((item) =>
            item.kind === 'flat' ? [{ label: item.label, href: item.href }] : item.items,
          ),
        },
        {
          title: 'Get in touch',
          links: [
            { label: chrome.headerCta.show ? 'Book a session' : 'Contact', href: '/contact/' },
          ],
        },
      ];

// "Cincinnati and West Chester"
const areas = (siteSettings?.serviceAreas ?? []).map((a) => a.trim()).filter(Boolean);
const areaLine =
  areas.length > 1 ? `${areas.slice(0, -1).join(', ')} and ${areas.at(-1)}` : (areas[0] ?? '');
// The zone's short name ("EST") until the script writes the time.
const zoneShort =
  new Intl.DateTimeFormat('en-US', { timeZone: site.timeZone, timeZoneName: 'short' })
    .formatToParts(new Date())
    .find((p) => p.type === 'timeZoneName')?.value ?? '';

const currentYear = new Date().getFullYear();
const LEGAL_LINKS = chrome.legalNav;
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

const here = publicPath(Astro.url.pathname);
const whereNext = siteSettings?.whereNext?.length
  ? whereNextRows(siteSettings.whereNext, here, await getAllPageSlugs())
  : [];
const pickedBar = pickActionBar(siteSettings?.actionBars, here);
const actionBar =
  pickedBar && !pickedBar.text
    ? { ...pickedBar, text: todayBarLine(facts, new Date(), site.timeZone) }
    : pickedBar;
---

<footer id="site-footer" class="site-footer--compact dk-footer bg-background text-foreground">
  {whereNext.length > 0 && <WhereNext rows={whereNext} />}

  {siteSettings?.newsletter?.enabled && (
    <div class="mx-auto max-w-content px-m pt-l">
      <div class="mx-auto max-w-md">
        <NewsletterSignup client:visible newsletter={siteSettings.newsletter} source="footer" />
      </div>
    </div>
  )}

  <div class="dk-credits">
    <p class="dk-credits__lead">
      <span class="dk-credits__role">Photographs by</span>
      <span class="dk-credits__star">{PHOTOGRAPHER}</span>
    </p>

    {creditLines.map((line) => (
      <div class="dk-credit">
        <p id={line.id} class="dk-credits__role">
          {line.role}
        </p>
        <ul class="dk-credit__names" aria-labelledby={line.id}>
          {line.names.map((c) => (
            <li>
              {c.href ? (
                <a
                  href={c.href}
                  {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {c.name}
                </a>
              ) : (
                <span>{c.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="site-footer__links dk-footer__pages">
      {columns.map((col, ci) => (
        <nav aria-labelledby={`footer-col-${ci}`}>
          <p id={`footer-col-${ci}`} class="dk-credits__role">
            {col.title}
          </p>
          <ul class="dk-credit__names dk-credit__names--stack">
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="dk-footer__booking">
    <p class="dk-footer__line">
      {areaLine ? `Booking sessions in ${areaLine}` : 'Booking sessions'}
      <span aria-hidden="true"> · </span>
      <time class="dk-clock" data-dk-clock data-tz={site.timeZone}>
        {zoneShort}
      </time>
    </p>
    {(email || phone || socialLinks.length > 0) && (
      <ul class="dk-footer__reach">
        {email && (
          <li>
            <CopyEmailButton email={email} variant="link" />
            <ToConfirm confirmed={facts.email?.confirmed} />
          </li>
        )}
        {phone && (
          <li>
            <a href={facts.phone?.href ?? `tel:${phone}`}>
              <Phone size={14} aria-hidden="true" />
              {phone}
            </a>
            <ToConfirm confirmed={facts.phone?.confirmed} />
          </li>
        )}
        {socialLinks.map((link) => {
          const Icon = socialIcon(link.platform);
          return (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                <Icon size={16} stroke={1.5} aria-hidden="true" />
                {socialLabel(link)}
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </div>

  <div class="dk-footer__small">
    <p>
      © {currentYear} {brandName}
    </p>
    {LEGAL_LINKS.length > 0 ? (
      LEGAL_LINKS.map((l) => <a href={l.href}>{l.label}</a>)
    ) : (
      <a href="/privacy/">Privacy policy</a>
    )}
    <a href="/studio" rel="nofollow">
      Studio
    </a>
    {siteCredit &&
      (siteCreditUrl ? (
        <a href={siteCreditUrl} target="_blank" rel="noopener noreferrer">
          {siteCredit}
        </a>
      ) : (
        <span>{siteCredit}</span>
      ))}
  </div>

  {/* The giant name, cropped by the footer's bottom edge. A link home, named in full. */}
  <a href="/" class="site-footer__brand dk-footer__bleed" aria-label={`${brandName} home`}>
    <span aria-hidden="true">{bigWord}</span>
  </a>

  {actionBar && <ActionBar bar={actionBar} />}
</footer>

<script>
  // Her local time in the booking line, on site.timeZone. Fixed-width box (erin.css), so the
  // swap from "EST" to "11:02 AM" moves nothing. Re-runs after View Transitions swaps.
  function tick() {
    for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-dk-clock]')) {
      const timeZone = el.dataset.tz;
      if (!timeZone) continue;
      try {
        el.textContent = new Intl.DateTimeFormat('en-US', {
          hour: 'numeric',
          minute: '2-digit',
          timeZone,
        }).format(new Date());
      } catch {
        // An unknown zone keeps the build's text.
      }
    }
  }
  const w = window as typeof window & { __dkClock?: number };
  tick();
  if (!w.__dkClock) w.__dkClock = window.setInterval(tick, 30_000);
  document.addEventListener('astro:page-load', tick);
</script>

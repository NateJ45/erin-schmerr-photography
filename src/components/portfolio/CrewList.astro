---
// scaffold-file: stories
// Safe to edit by hand
// Page-builder block `crewSection` (storyIndexSection.ts): who is behind the
// work. A short paragraph on the left; on the right a crew list set like a
// story's credit (role, then name; the `.credit-block` look from
// CreditBlock.astro, one column here so it reads as a list). An optional text
// link under the list. Stacks on a phone, paragraph first.
//
// SELF_CONTAINED: plain page ground, no surface prop.
import CtaLink from '@/components/CtaLink.astro';
import PortableText from '@/components/PortableText';
import type { PortableTextBlock } from '@portabletext/types';
import type { ProjectedCtaBlock } from '@/lib/pageBuilder.types';
import '@/styles/portfolio.css';

interface Props {
  eyebrow?: string;
  heading?: string;
  body?: PortableTextBlock[] | null;
  crewHeading?: string;
  crew?: { _key?: string; role?: string; name?: string }[] | null;
  link?: ProjectedCtaBlock | null;
  headingId?: string;
}

const {
  eyebrow,
  heading = '',
  body,
  crewHeading = 'The crew',
  crew,
  link,
  headingId = 'crew-heading',
} = Astro.props;
const rows = (crew ?? []).filter((c) => c?.role && c?.name);
const hasBody = Array.isArray(body) && body.length > 0;
---

{(heading || hasBody || rows.length > 0) && (
  <section class="bg-background" aria-labelledby={headingId}>
    <div class="crew split mx-auto max-w-content px-m py-section-lg">
      <div class="crew__text">
        {eyebrow && <p class="portfolio-label mb-4">{eyebrow}</p>}
        <h2 id={headingId} class="font-display text-h2">
          {heading}
        </h2>
        {hasBody && <PortableText value={body} className="crew__body mt-6" />}
      </div>
      {rows.length > 0 && (
        <div class="crew__list">
          <p class="portfolio-label mb-4">{crewHeading}</p>
          <dl class="credit-block crew__credits">
            {rows.map((c) => (
              <div>
                <dt class="portfolio-label">{c.role}</dt>
                <dd class="font-display text-foreground">{c.name}</dd>
              </div>
            ))}
          </dl>
          {link?.label && (
            <p class="mt-8">
              <CtaLink cta={link} variant="secondary" />
            </p>
          )}
        </div>
      )}
    </div>
  </section>
)}

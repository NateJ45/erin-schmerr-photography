---
// scaffold-file: stories
// Safe to edit by hand
// Page-builder block `storyIndex` (storyIndexSection.ts): the featured stories
// as a grid of covers or a list of titles. It reads the stories itself
// (getFeaturedStories), like the Journal posts block, so the block holds only
// its heading, layout and count, and with no Sanity data it shows the
// placeholder stories. Both views are rendered; a Grid / List toggle switches
// them (the block's `layout` picks the one shown first, and the only one shown
// with JavaScript off). In list view, hovering a title on a mouse reveals its
// cover beside the list (DESIGN.md "Story index").
//
// SELF_CONTAINED: draws on the plain page ground, no surface prop.
import StoryCard from '@/components/portfolio/StoryCard.astro';
import FocusImage from '@/components/portfolio/FocusImage.astro';
import { getFeaturedStories } from '@/lib/storyQueries';
import { formatMonthYear } from '@/lib/portfolio';
import '@/styles/portfolio.css';

interface Props {
  heading?: string;
  layout?: 'grid' | 'list';
  limit?: number;
  headingId?: string;
}

const {
  heading = 'Selected stories',
  layout = 'grid',
  limit = 6,
  headingId = 'story-index-heading',
} = Astro.props;

const stories = await getFeaturedStories(limit);
---

{stories.length > 0 && (
  <section class="story-index bg-background" data-view={layout} aria-labelledby={headingId}>
    <div class="mx-auto max-w-content px-m py-section-lg">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 id={headingId} class="font-display text-h2">
          {heading}
        </h2>
        <a class="portfolio-label portfolio-link" href="/stories/">
          All stories
        </a>
      </div>
      <div class="story-index__toggle mt-6" role="group" aria-label="View stories as" hidden>
        <button
          type="button"
          data-view-btn="grid"
          aria-pressed={layout === 'grid' ? 'true' : 'false'}
        >
          Grid
        </button>
        <button
          type="button"
          data-view-btn="list"
          aria-pressed={layout === 'list' ? 'true' : 'false'}
        >
          List
        </button>
      </div>
      <div class="story-grid story-index__grid mt-8">
        {stories.map((story) => (
          <StoryCard {story} level="h3" />
        ))}
      </div>
      <ol class="story-index__list mt-8 list-none border-t border-border">
        {stories.map((story) => (
          <li class="story-index__row border-b border-border">
            <a
              href={`/stories/${story.slug}/`}
              class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-5 text-foreground no-underline"
            >
              <span class="story-index__title font-display text-h3">{story.title}</span>
              <span class="portfolio-label">
                {[story.location, formatMonthYear(story.date)].filter(Boolean).join(', ')}
              </span>
            </a>
            <div class="story-index__peek" aria-hidden="true">
              <FocusImage photo={story.cover} width={480} sizes="18rem" crop={4 / 5} alt="" />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<script>
  // Grid / List toggle. The section ships with data-view set from the block's
  // layout, so with JavaScript off it shows that one view and the toggle stays
  // hidden. Re-runs after a client-side navigation.
  function initStoryIndex() {
    document.querySelectorAll<HTMLElement>('.story-index').forEach((section) => {
      if (section.dataset.ready) return;
      section.dataset.ready = '1';
      const toggle = section.querySelector<HTMLElement>('.story-index__toggle');
      if (!toggle) return;
      toggle.hidden = false;
      toggle.querySelectorAll<HTMLButtonElement>('[data-view-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const view = btn.dataset.viewBtn ?? 'grid';
          section.dataset.view = view;
          toggle.querySelectorAll<HTMLButtonElement>('[data-view-btn]').forEach((b) => {
            b.setAttribute('aria-pressed', String(b === btn));
          });
        });
      });
    });
  }
  initStoryIndex();
  document.addEventListener('astro:page-load', initStoryIndex);
</script>

---
// scaffold-file: stories
// Safe to edit by hand
// The /stories/ page as a film reel (picked 2026-11-18, design-directions
// "direction I"; DESIGN.md "Stories reel"). One flat track: the title card
// (the page's h1), then a chapter card per decade (h2), each followed by its
// stories as frames. A frame is one link to the story, holding the cover, the
// title (h3) and "place, month year" like the cover slides' captions.
//
// Chapters are derived at build time (rule 15, `reelChapters()` in
// src/lib/portfolio.ts): the decade a story's look comes from when its
// "Started from", title or short line names one, otherwise the decade it was
// made. Nothing is typed in the Studio for them.
//
// Two modes, one markup (portfolio.css, REEL):
// - PINNED, only under html.motion with a mouse-like pointer from 48rem: the
//   stage sticks under the header and native vertical scrolling slides the
//   track sideways (a CSS view() timeline; src/scripts/story-reel.ts drives it
//   where that is unsupported). The reel's height is worked out in CSS from
//   the summed photo ratios passed in here, so nothing moves when it loads.
// - STRIP, everywhere else (touch, reduced motion, no JavaScript, narrow): a
//   native sideways strip with scroll-snap.
import FocusImage from '@/components/portfolio/FocusImage.astro';
import { formatMonthYear, photoRatio, reelChapters } from '@/lib/portfolio';
import type { Story } from '@/lib/storyQueries';
import '@/styles/portfolio.css';

interface Props {
  stories: Story[];
  /** True when every story is a built-in placeholder (no Sanity data). */
  placeholder?: boolean;
}

const { stories, placeholder = false } = Astro.props;
const chapters = reelChapters(stories);
const pad = (n: number) => String(n).padStart(2, '0');
const ratio = (s: Story) => Number(photoRatio(s.cover).toFixed(4));

// The sizes the CSS needs to know the track's width before anything loads:
// the photos' summed width-over-height, the cards (title plus one per
// chapter) and the gaps between all the items.
const ratioSum = stories.reduce((sum, s) => sum + ratio(s), 0);
const cards = 1 + chapters.length;
const gaps = Math.max(0, cards + stories.length - 1);
const reelStyle = `--reel-ratio: ${ratioSum.toFixed(4)}; --reel-cards: ${cards}; --reel-gaps: ${gaps}`;

const count = stories.length;
let frameIndex = 0;
---

<section class="reel" data-reel aria-labelledby="stories-heading" style={reelStyle}>
  <div class="reel__run" data-reel-run>
    <div class="reel__stage" data-reel-stage>
      <div class="reel__track" data-reel-track>
        <div class="reel__card reel__card--title">
          <h1 id="stories-heading" class="reel__h1 font-display">
            Stories
          </h1>
          <p class="reel__lede">
            {count === 1 ? 'One story' : `${count} stories`}, by the decade each look comes from.
          </p>
          {placeholder && (
            <p class="portfolio-label">
              Placeholder stories, shown until the first one is published.
            </p>
          )}
          <p class="reel__hint">
            <span class="reel__hint-pinned">Scroll down and the reel runs sideways.</span>
            <span class="reel__hint-strip">Swipe or scroll sideways through the reel.</span>
          </p>
        </div>
        {chapters.map((chapter, c) => (
          <>
            <div class="reel__card reel__card--chapter">
              <p class="reel__label">
                <span>Reel {pad(c + 1)}</span>
                <span>
                  {chapter.stories.length === 1 ? '1 story' : `${chapter.stories.length} stories`}
                </span>
              </p>
              <h2 class="reel__h2 font-display">
                {chapter.decade === null ? (
                  'Undated'
                ) : (
                  <>
                    The <em>{chapter.decade}s</em>
                  </>
                )}
              </h2>
            </div>
            {chapter.stories.map((story) => {
              const i = frameIndex++;
              const where = [story.location, formatMonthYear(story.date)]
                .filter(Boolean)
                .join(', ');
              return (
                <a
                  class="reel__frame"
                  href={`/stories/${story.slug}/`}
                  style={`--r: ${ratio(story)}`}
                >
                  <FocusImage
                    photo={story.cover}
                    width={1600}
                    sizes="(min-width: 48rem) 46vw, 85vw"
                    loading={i < 2 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : i < 2 ? 'auto' : 'low'}
                    alt=""
                    class="reel__pic"
                    pull={false}
                  />
                  <span class="reel__caption">
                    <span class="reel__count" aria-hidden="true">
                      {pad(i + 1)}
                    </span>
                    <span class="reel__words">
                      <h3 class="reel__title">{story.title}</h3>
                      {where && <span class="reel__where">{where}</span>}
                    </span>
                  </span>
                </a>
              );
            })}
          </>
        ))}
      </div>
      <div class="reel__progress" aria-hidden="true">
        <b></b>
      </div>
    </div>
  </div>
</section>

<script>
  import '@/scripts/story-reel';
</script>

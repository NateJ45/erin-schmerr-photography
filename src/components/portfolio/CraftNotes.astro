---
// scaffold-file: stories
// Safe to edit by hand
// Page-builder block `craftNotes` (storyIndexSection.ts): how the work is made,
// as numbered notes on the site's one split (.split, card 91): the heading and
// its sentence in the text track, held in view from 1024px up while the notes
// pass in the other; each note is
// a large italic numeral, a short title and a sentence, parted by hairlines.
// One column on a phone. Draws nothing without notes.
//
// SELF_CONTAINED: plain page ground, no surface prop.
import '@/styles/portfolio.css';

interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
  notes?: { _key?: string; title?: string; body?: string }[] | null;
  headingId?: string;
}

const {
  eyebrow,
  heading = 'How I get the look',
  intro,
  notes,
  headingId = 'craft-notes-heading',
} = Astro.props;
const rows = (notes ?? []).filter((n) => n?.title);
const pad = (n: number) => String(n).padStart(2, '0');
---

{rows.length > 0 && (
  <section class="bg-background" aria-labelledby={headingId}>
    <div class="craft-notes split mx-auto max-w-content px-m py-section-lg">
      <div class="craft-notes__head">
        {eyebrow && <p class="portfolio-label mb-4">{eyebrow}</p>}
        <h2 id={headingId} class="font-display text-h2">
          {heading}
        </h2>
        {intro && <p class="mt-4 max-w-md text-muted-foreground">{intro}</p>}
      </div>
      <ol class="craft-notes__list list-none">
        {rows.map((note, i) => (
          <li class="craft-note">
            <span class="craft-note__n font-display" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <div>
              <h3 class="craft-note__title font-display">{note.title}</h3>
              {note.body && <p class="mt-2 text-muted-foreground">{note.body}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

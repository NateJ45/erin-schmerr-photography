---
// Foundation, edit with care
// The site menu: "the jewel flood" (DESIGN.md, Components; 2026-11-20; PORTS.md card 157 for
// the dialog machinery). Replaces the same day's paper "boutique drop". Despite the file name
// it is the menu at EVERY width now: the "Menu" button sits at the end of the header row on a
// desktop too, beside the server-rendered nav (rule 4 keeps that nav).
//
// Built from two Details references (2026-11-20):
//   - Details Vault "Reveal Navigation 2.0" (vault:navigation-07): coloured sheets stacked
//     behind the panel, each unclipping a beat after the one before, and the menu button
//     whose label rolls and whose mark turns. The Vault piece clips the PAGE itself inside a
//     100dvh scroll box; this site keeps the browser's own scroll (rule 5), so here the
//     sheets and the panel are clip layers inside the dialog and the page behind is pushed
//     up a little instead (the Radaville detail below).
//   - Radaville Studio (details.so/inspo/radaville-uugkpt): the full-screen panel that slides
//     up over the page while the page is pushed back (1.1s, cubic-bezier(0.76, 0, 0.24, 1));
//     huge serif page names rising out of their own line masks, 0.1s apart; on hover a name
//     swaps letter by letter from roman to italic (scaleX, staggered over 0.18s); a preview
//     photo in the lower right that turns in from below for the hovered page; numbered info
//     columns (contact, where, follow) on the right that fade in last.
//
// Order of the opening: an amber sheet, a magenta sheet, then the wine panel rise from the
// bottom, 80ms apart; the page behind lifts 4rem; the names roll up; the info and the photo
// arrive. Closing runs it the other way: the names leave upwards, the panel and sheets clip
// away to the top, the page settles. Reduced motion: the panel fades, nothing rolls or turns.
//
// The browser does the dialog work: showModal() gives the focus trap, Escape, the inert page
// behind and focus back on the button. The "Close" button sits where "Menu" was. The page
// behind does not scroll (globals.css). It closes as a View Transitions navigation starts.
// With JavaScript off the "Menu" button is a real link to the footer (#site-footer), whose
// page list reaches every page, so nothing is hidden behind a script.
//
// With Site settings > Phone menu groups filled in (card 191), the names come in labelled
// groups: each group's name is an h2 that labels its list. No groups = one list.
//
// Images: lazy, inside a closed dialog, so a page that never opens the menu fetches none.
// Styles: src/styles/chrome-header.css ("The menu").

import type { NavItem } from '@/lib/siteSettings';
import type { PhoneMenuGroup } from '@/lib/wayfinding';
import type { ChromePrint } from './darkroom/chrome-data';
import { telHref } from '@/lib/phone';

interface Props {
  links: NavItem[];
  siteSettings?: {
    tagline?: string;
    email?: string;
    phone?: string;
    socialInstagram?: string;
    socialFacebook?: string;
  } | null;
  /** The wordmark's name, for the menu's own wordmark. */
  brandName?: string;
  /** The paper-coloured wordmark (logo-dark.svg) the menu draws on wine. */
  logoSrc?: string;
  /** The menu's primary button: the header's own button. */
  cta?: { show: boolean; label: string; href: string };
  /** The optional second header button (card 187). */
  secondary?: { label: string; href: string } | null;
  /** Visitor search is on (card 126). */
  search?: boolean;
  /** Card 191: Site settings > Phone menu groups, resolved. Empty = one list. */
  groups?: PhoneMenuGroup[];
  /** The page being viewed (publicPath), so its line is marked. */
  current?: string;
  /** The featured story covers (chrome-data.ts), for the preview photo. */
  frames?: ChromePrint[];
  /** A page's own picture, where the site already shows one. */
  pagePrints?: Record<string, ChromePrint>;
  /** The header's place block lines ("Cincinnati", "West Chester, Ohio"). */
  place?: string[];
}

const {
  links,
  siteSettings,
  brandName = 'Home',
  logoSrc,
  cta = { show: true, label: 'Get in touch', href: '/contact/' },
  secondary = null,
  search = false,
  groups = [],
  current,
  frames = [],
  pagePrints = {},
  place = [],
} = Astro.props;

const grouped = groups.length > 0;
const isCurrent = (href: string) =>
  !!current && (href === '/' ? current === '/' : current.startsWith(href.replace(/\/?$/, '/')));

// Dropdown groups in the top menu become lines of their own here.
const flat = links.flatMap((item) =>
  item.kind === 'flat' ? [{ label: item.label, href: item.href }] : item.items,
);
const lists = grouped
  ? groups.map((g) => ({ title: g.title, links: g.links }))
  : [{ title: '', links: flat }];

/** 01, 02, 03 ... the line numbers (Radaville's superscript page numbers). */
const num = (n: number) => String(n).padStart(2, '0');

/** A name as letters, so the hover can swap it letter by letter. */
const letters = (label: string) => Array.from(label);

// One photo per line: the page's own picture, else the covers in turn.
const tones: ChromePrint['tone'][] = ['sand', 'dusk', 'paper', 'ink'];
const printAt = (href: string, i: number): ChromePrint =>
  pagePrints[href] ?? frames[i % Math.max(1, frames.length)] ?? { tone: tones[i % 4] };
const allLinks = lists.flatMap((l) => l.links);
const prints = allLinks.map((link, i) => printAt(link.href, i));
const startAt = Math.max(
  0,
  allLinks.findIndex((l) => isCurrent(l.href)),
);

const email = siteSettings?.email;
const phone = siteSettings?.phone;
const ig = siteSettings?.socialInstagram;
const fb = siteSettings?.socialFacebook;
// The info columns, numbered like Radaville's: only the ones with something in them.
const info = [
  (email || phone) && 'contact',
  place.length > 0 && 'where',
  (ig || fb) && 'follow',
].filter(Boolean) as string[];
let n = 0;
---

<div class="site-header__menu">
  {/* A link until the script below takes it over: with JavaScript off it jumps to the footer. */}
  <a href="#site-footer" aria-controls="site-menu" data-menu-open class="jw-toggle">
    <span class="jw-toggle__label" aria-hidden="true">
      <span class="jw-toggle__roll">
        <span>Menu</span>
        <span>Menu</span>
      </span>
    </span>
    <span class="sr-only">Menu</span>
    <span class="jw-toggle__mark" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </span>
  </a>

  <dialog
    id="site-menu"
    class={grouped ? 'mobile-menu jw-menu mobile-menu--groups' : 'mobile-menu jw-menu'}
    aria-labelledby="site-menu-title"
    data-menu
  >
    {/* The stacked sheets (Vault navigation-07): they rise just ahead of the panel. */}
    <span class="jw-sheet jw-sheet--amber" aria-hidden="true"></span>
    <span class="jw-sheet jw-sheet--magenta" aria-hidden="true"></span>

    <div class="mobile-menu__panel jw-menu__panel">
      <div class="jw-menu__top">
        <a href="/" class="jw-menu__brand" aria-label={`${brandName} home`}>
          {logoSrc ? (
            <img src={logoSrc} alt="" width="258" height="25" decoding="async" loading="lazy" />
          ) : (
            <span>{brandName}</span>
          )}
        </a>
        <p id="site-menu-title" class="sr-only">
          Menu
        </p>
        <button type="button" class="jw-toggle jw-toggle--close" data-menu-close>
          <span class="jw-toggle__label" aria-hidden="true">
            <span class="jw-toggle__roll">
              <span>Close</span>
              <span>Close</span>
            </span>
          </span>
          <span class="sr-only">Close menu</span>
          <span class="jw-toggle__mark" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            >
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </span>
        </button>
      </div>

      <div class="jw-menu__body">
        <nav class="jw-menu__nav" aria-label="Primary mobile">
          {lists.map((list, gi) => (
            <div class={grouped ? 'mobile-menu__group jw-group' : 'jw-group'}>
              {list.title && (
                <h2 id={`site-menu-group-${gi}`} class="jw-group__label">
                  {list.title}
                </h2>
              )}
              <ul
                class="jw-list"
                aria-labelledby={list.title ? `site-menu-group-${gi}` : undefined}
              >
                {list.links.map((link) => {
                  const i = n++;
                  const chars = letters(link.label);
                  return (
                    <li class="jw-line" style={`--i: ${i}`}>
                      <a
                        href={link.href}
                        class="jw-line__link"
                        data-frame={i}
                        aria-current={isCurrent(link.href) ? 'page' : undefined}
                      >
                        <span class="jw-line__clip">
                          <span class="jw-line__roll">
                            <span class="sr-only">{link.label}</span>
                            <span class="jw-word" aria-hidden="true" style={`--n: ${chars.length}`}>
                              {chars.map((c, ci) => (
                                <span class="jw-char" style={`--c: ${ci}`}>
                                  {c}
                                </span>
                              ))}
                            </span>
                            <span
                              class="jw-word jw-word--alt"
                              aria-hidden="true"
                              style={`--n: ${chars.length}`}
                            >
                              {chars.map((c, ci) => (
                                <span class="jw-char" style={`--c: ${ci}`}>
                                  {c}
                                </span>
                              ))}
                            </span>
                          </span>
                        </span>
                        <span class="jw-line__num" aria-hidden="true">
                          {num(i + 1)}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </nav>

        <div class="jw-menu__side">
          {info.length > 0 && (
            <dl class="jw-info">
              {info.map((kind, k) => (
                <div class="jw-info__block">
                  <dt>
                    <span class="jw-info__num">{num(k + 1)}</span>
                    {kind === 'contact' ? 'Contact' : kind === 'where' ? 'Where' : 'Follow'}
                  </dt>
                  {kind === 'contact' && (
                    <>
                      {email && (
                        <dd>
                          <a href={`mailto:${email}`}>{email}</a>
                        </dd>
                      )}
                      {phone && (
                        <dd>
                          <a href={telHref(phone)}>{phone}</a>
                        </dd>
                      )}
                    </>
                  )}
                  {kind === 'where' && place.map((line) => <dd>{line}</dd>)}
                  {kind === 'follow' && (
                    <>
                      {ig && (
                        <dd>
                          <a href={ig} target="_blank" rel="noopener noreferrer">
                            Instagram
                          </a>
                        </dd>
                      )}
                      {fb && (
                        <dd>
                          <a href={fb} target="_blank" rel="noopener noreferrer">
                            Facebook
                          </a>
                        </dd>
                      )}
                    </>
                  )}
                </div>
              ))}
            </dl>
          )}

          {/* The preview photo (decorative): every line's photo stacked, one shown. */}
          <div class="jw-frame" aria-hidden="true" data-frames>
            {prints.map((p, i) => (
              <span
                class:list={[
                  'jw-frame__photo',
                  `bq-tone--${p.tone}`,
                  { 'is-shown': i === startAt },
                ]}
              >
                {p.src && (
                  <img
                    src={p.src}
                    srcset={p.srcset}
                    alt=""
                    width="160"
                    height="200"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="jw-menu__foot">
        {cta.show && (
          <a href={cta.href} class="jw-button">
            {cta.label}
          </a>
        )}
        {secondary && (
          <a href={secondary.href} class="jw-small">
            {secondary.label}
          </a>
        )}
        {/* Visitor search (card 126). A real link to /search/, so it works without the script. */}
        {search && (
          <a href="/search/" data-menu-search class="jw-small">
            Search the site
          </a>
        )}
      </div>
    </div>
  </dialog>
</div>

<script>
  // Open and close the menu. The focus trap, Escape, the inert page behind and focus back on the
  // button are the native <dialog>'s own. The header is swapped on every View Transitions
  // navigation, so the listeners are delegated from the document and bound once.
  const menu = () => document.querySelector<HTMLDialogElement>('dialog[data-menu]');
  const trigger = () => document.querySelector<HTMLAnchorElement>('[data-menu-open]');
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;

  // ---- The preview photo: turn in the hovered line's photo, else cycle gently. ----
  const CYCLE_MS = 3600;
  let cycle: number | undefined;
  let shown = 0;

  function show(i: number) {
    const photos = menu()?.querySelectorAll<HTMLElement>('.jw-frame__photo');
    if (!photos?.length) return;
    const next = ((i % photos.length) + photos.length) % photos.length;
    if (next === shown && photos[next].classList.contains('is-shown')) return;
    // The outgoing photo stays underneath while the new one turns in over it.
    photos.forEach((p, k) => {
      p.classList.toggle('is-prev', k === shown && k !== next);
      p.classList.toggle('is-shown', k === next);
    });
    shown = next;
  }
  function stopCycle() {
    if (cycle) window.clearInterval(cycle);
    cycle = undefined;
  }
  function startCycle() {
    stopCycle();
    if (reduced()) return;
    cycle = window.setInterval(() => show(shown + 1), CYCLE_MS);
  }
  function pick(target: EventTarget | null) {
    const link = (target as Element | null)?.closest?.<HTMLElement>('[data-frame]');
    if (!link || !menu()?.contains(link)) return;
    stopCycle();
    show(Number(link.dataset.frame));
  }

  // The button is a link to the footer until now: make it the button it acts as.
  function upgrade() {
    const t = trigger();
    if (!t || t.dataset.menuReady !== undefined) return;
    t.dataset.menuReady = '';
    t.setAttribute('role', 'button');
    t.setAttribute('aria-haspopup', 'dialog');
    t.setAttribute('aria-expanded', 'false');
  }

  function open() {
    const d = menu();
    if (!d || d.open) return;
    d.classList.remove('is-leaving');
    const start = d.querySelector('.jw-frame__photo.is-shown');
    shown = start ? Array.from(start.parentElement!.children).indexOf(start) : 0;
    d.showModal();
    // The page behind lifts while the sheets rise (chrome-header.css, "The page push").
    root.classList.add('menu-push');
    trigger()?.setAttribute('aria-expanded', 'true');
    startCycle();
  }

  function settle(d: HTMLDialogElement) {
    d.classList.remove('is-leaving');
    root.classList.remove('menu-push');
    if (d.open) d.close();
  }

  // Closing plays the flood in reverse before the dialog really closes; reduced motion and a
  // navigation close at once.
  function close(now = false) {
    const d = menu();
    stopCycle();
    if (!d?.open) {
      root.classList.remove('menu-push');
      return;
    }
    if (now || reduced() || d.classList.contains('is-leaving')) {
      settle(d);
      return;
    }
    d.classList.add('is-leaving');
    root.classList.remove('menu-push');
    // The amber sheet clips away last.
    const last = d.querySelector('.jw-sheet--amber');
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      settle(d);
    };
    last?.addEventListener('animationend', finish, { once: true });
    window.setTimeout(finish, 1300);
  }

  const w = window as typeof window & { __menuBound?: boolean };
  if (!w.__menuBound) {
    w.__menuBound = true;

    // Capture phase: the button is a same-page #link, which Astro's router would otherwise take.
    document.addEventListener(
      'click',
      (e) => {
        if (e.button !== 0) return;
        const target = e.target as Element | null;
        if (!target?.closest) return;
        if (target.closest('[data-menu-open]')) {
          e.preventDefault();
          e.stopPropagation();
          open();
          return;
        }
        const d = menu();
        if (!d?.open || !d.contains(target)) return;
        if (target.closest('[data-menu-close]')) {
          close();
          return;
        }
        // "Search the site": the menu closes first, then the search dialog opens, so the two
        // modals never hold focus at once. A modified click still opens /search/ in a new tab.
        if (target.closest('[data-menu-search]')) {
          const me = e as MouseEvent;
          if (me.ctrlKey || me.metaKey || me.shiftKey) return;
          e.preventDefault();
          // The search dialog's own click listener would read this click as "a link inside the
          // open dialog" and shut it again the moment it opened.
          e.stopImmediatePropagation();
          close(true);
          window.dispatchEvent(new CustomEvent('site-search:open'));
          return;
        }
        // Any other link closes the menu as it is followed.
        if (target.closest('a')) close(true);
      },
      true,
    );

    // Escape: play the reverse flood too (the browser would otherwise close at once).
    document.addEventListener(
      'cancel',
      (e) => {
        if (!(e.target as Element)?.matches?.('dialog[data-menu]')) return;
        e.preventDefault();
        close();
      },
      true,
    );

    // The photo follows the line a pointer, a finger or the keyboard is on.
    document.addEventListener('pointerover', (e) => pick(e.target), { passive: true });
    document.addEventListener('touchstart', (e) => pick(e.target), { passive: true });
    document.addEventListener('focusin', (e) => {
      if ((e.target as Element)?.matches?.(':focus-visible')) pick(e.target);
    });

    // Keep the trigger's state right whichever way the menu closed (Close, Escape, a link).
    document.addEventListener(
      'close',
      (e) => {
        if ((e.target as Element)?.matches?.('dialog[data-menu]')) {
          stopCycle();
          root.classList.remove('menu-push');
          trigger()?.setAttribute('aria-expanded', 'false');
        }
      },
      true,
    );

    // Close as a View Transitions navigation starts (Back or Forward too), so the page behind is
    // not left inert under the swap.
    document.addEventListener('astro:before-preparation', () => close(true));
    document.addEventListener('astro:page-load', upgrade);
  }
  upgrade();
</script>

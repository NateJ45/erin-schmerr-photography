---
// Foundation, edit with care
// The phone menu: "the contact sheet" (DESIGN.md, Components; 2026-11-18; PORTS.md card 157
// for the dialog machinery).
//
// The "Menu" button opens a full-screen native <dialog>: her featured story covers laid out
// as small frames on a black film ground, sprocket holes down both edges and a frame number
// under each, with every page's name set large in Instrument Serif on a paper chip over its
// frame. The page you are on is ringed in grease pencil. As the sheet opens the frames
// develop one after another (blur to sharp, 60ms apart; erin-motion.css); reduced motion
// shows them developed at once. "Book a session" sits under the sheet.
//
// The browser does the dialog work: showModal() gives the focus trap, Escape, the inert page
// behind and focus back on the button. The "Close" button sits where "Menu" was. The page
// behind does not scroll (globals.css). It closes as a View Transitions navigation starts.
// With JavaScript off the "Menu" button is a real link to the footer (#site-footer), whose
// page list reaches every page, so nothing is hidden behind a script.
//
// With Site settings > Phone menu groups filled in (card 191), the frames come in labelled
// groups: each group's name is an h2 that labels its list. No groups = one sheet of frames.
//
// Images: lazy, inside a closed dialog, so a page that never opens the menu fetches none.

import { Mail, Phone, Search } from 'lucide-react';
import { IconBrandInstagram, IconBrandFacebook } from '@tabler/icons-react';
import { telHref } from '@/lib/phone';
import type { NavItem } from '@/lib/siteSettings';
import type { PhoneMenuGroup } from '@/lib/wayfinding';
import GreasePencil from './darkroom/GreasePencil.astro';
import { frameNumber, type ChromePrint } from './darkroom/chrome-data';

interface Props {
  links: NavItem[];
  siteSettings?: {
    tagline?: string;
    email?: string;
    phone?: string;
    socialInstagram?: string;
    socialFacebook?: string;
  } | null;
  /** Kept for callers; the contact sheet has no logo at its foot. */
  brandName?: string;
  /** The menu's primary button: the header's own button. */
  cta?: { show: boolean; label: string; href: string };
  /** The optional second header button (card 187). */
  secondary?: { label: string; href: string } | null;
  /** Visitor search is on (card 126). */
  search?: boolean;
  /** Card 191: Site settings > Phone menu groups, resolved. Empty = one sheet. */
  groups?: PhoneMenuGroup[];
  /** The page being viewed (publicPath), so its frame is ringed. */
  current?: string;
  /** The featured story covers (chrome-data.ts), cycled across the frames. */
  frames?: ChromePrint[];
  /** A page's own picture, where the site already shows one. */
  pagePrints?: Record<string, ChromePrint>;
}

const {
  links,
  siteSettings,
  cta = { show: true, label: 'Book a session', href: '/contact/' },
  secondary = null,
  search = false,
  groups = [],
  current,
  frames = [],
  pagePrints = {},
} = Astro.props;

const grouped = groups.length > 0;
const isCurrent = (href: string) =>
  !!current && (href === '/' ? current === '/' : current.startsWith(href.replace(/\/?$/, '/')));

// Dropdown groups in the top menu become frames of their own on the sheet.
const flat = links.flatMap((item) =>
  item.kind === 'flat' ? [{ label: item.label, href: item.href }] : item.items,
);
const sheets = grouped
  ? groups.map((g) => ({ title: g.title, links: g.links }))
  : [{ title: '', links: flat }];

const tones: ChromePrint['tone'][] = ['dusk', 'sand', 'ink', 'paper'];
const printAt = (href: string, i: number): ChromePrint =>
  pagePrints[href] ?? frames[i % Math.max(1, frames.length)] ?? { tone: tones[i % 4] };

const tagline = siteSettings?.tagline;
const email = siteSettings?.email;
const phone = siteSettings?.phone;
const ig = siteSettings?.socialInstagram;
const fb = siteSettings?.socialFacebook;
let n = 0;
---

<div class="site-header__menu">
  {/* A link until the script below takes it over: with JavaScript off it jumps to the footer. */}
  <a href="#site-footer" aria-controls="site-menu" data-menu-open class="dk-menu-button">
    Menu
  </a>

  <dialog
    id="site-menu"
    class={grouped ? 'mobile-menu dk-sheet mobile-menu--groups' : 'mobile-menu dk-sheet'}
    aria-labelledby="site-menu-title"
    data-menu
  >
    <div class="mobile-menu__panel dk-sheet__panel">
      <div class="dk-sheet__top">
        <p id="site-menu-title" class="dk-sheet__title">
          Menu
        </p>
        <span class="dk-sheet__edge" aria-hidden="true">
          Tate 400 · contact sheet
        </span>
        <button type="button" class="dk-menu-button dk-menu-button--close" data-menu-close>
          Close
        </button>
      </div>

      <nav class="dk-sheet__nav" aria-label="Primary mobile">
        {sheets.map((sheet, gi) => (
          <div class={grouped ? 'mobile-menu__group dk-sheet__group' : 'dk-sheet__group'}>
            {sheet.title && (
              <h2 id={`site-menu-group-${gi}`} class="dk-sheet__group-label">
                {sheet.title}
              </h2>
            )}
            <ul
              class="dk-sheet__frames"
              aria-labelledby={sheet.title ? `site-menu-group-${gi}` : undefined}
            >
              {sheet.links.map((link) => {
                const i = n++;
                const p = printAt(link.href, i);
                const here = isCurrent(link.href);
                return (
                  <li class="dk-frame" style={`--i: ${i}`}>
                    <a
                      href={link.href}
                      class="dk-frame__link"
                      aria-current={here ? 'page' : undefined}
                    >
                      <span class={`dk-frame__photo dk-tone--${p.tone}`} aria-hidden="true">
                        {p.src && (
                          <img
                            src={p.src}
                            srcset={p.srcset}
                            alt=""
                            width="160"
                            height="200"
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                      </span>
                      <span class="dk-frame__chip">
                        <span class="dk-frame__label">{link.label}</span>
                        {here && <GreasePencil />}
                      </span>
                      <span class="dk-frame__num" aria-hidden="true">
                        {frameNumber(i)}
                        <span>{'▸'}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </nav>

      <div class="dk-sheet__actions">
        {cta.show && (
          <a href={cta.href} class="dk-button dk-button--safelight dk-sheet__cta">
            <span class="dk-safelight" aria-hidden="true"></span>
            {cta.label}
          </a>
        )}
        {secondary && (
          <a href={secondary.href} class="dk-button dk-button--paper dk-sheet__cta">
            {secondary.label}
          </a>
        )}
        {/* Visitor search (card 126). A real link to /search/, so it works without the script. */}
        {search && (
          <a href="/search/" data-menu-search class="dk-sheet__search">
            <Search size={18} aria-hidden="true" />
            Search the site
          </a>
        )}
      </div>

      {tagline && <p class="dk-sheet__tagline">{tagline}</p>}

      {(email || phone || ig || fb) && (
        <div class="dk-sheet__contact">
          {email && (
            <a href={`mailto:${email}`}>
              <Mail size={16} aria-hidden="true" />
              {email}
            </a>
          )}
          {phone && (
            <a href={telHref(phone)}>
              <Phone size={16} aria-hidden="true" />
              {phone}
            </a>
          )}
          {ig && (
            <a href={ig} target="_blank" rel="noopener noreferrer">
              <IconBrandInstagram size={18} stroke={1.5} aria-hidden="true" />
              Instagram
            </a>
          )}
          {fb && (
            <a href={fb} target="_blank" rel="noopener noreferrer">
              <IconBrandFacebook size={18} stroke={1.5} aria-hidden="true" />
              Facebook
            </a>
          )}
        </div>
      )}
    </div>
  </dialog>
</div>

<script>
  // Open and close the menu. The focus trap, Escape, the inert page behind and focus back on the
  // hamburger are the native <dialog>'s own. The header is swapped on every View Transitions
  // navigation, so the listeners are delegated from the document and bound once.
  const menu = () => document.querySelector<HTMLDialogElement>('dialog[data-menu]');
  const trigger = () => document.querySelector<HTMLAnchorElement>('[data-menu-open]');

  // The hamburger is a link to the footer until now: make it the button it acts as.
  function upgrade() {
    const t = trigger();
    if (!t || t.dataset.menuReady !== undefined) return;
    t.dataset.menuReady = '';
    t.setAttribute('role', 'button');
    t.setAttribute('aria-haspopup', 'dialog');
    t.setAttribute('aria-expanded', 'false');
  }

  function open() {
    const d = menu();
    if (!d || d.open) return;
    d.showModal();
    trigger()?.setAttribute('aria-expanded', 'true');
  }

  function close() {
    const d = menu();
    if (d?.open) d.close();
  }

  const w = window as typeof window & { __menuBound?: boolean };
  if (!w.__menuBound) {
    w.__menuBound = true;

    // Capture phase: the hamburger is a same-page #link, which Astro's router would otherwise take.
    document.addEventListener(
      'click',
      (e) => {
        if (e.button !== 0) return;
        const target = e.target as Element | null;
        if (!target?.closest) return;
        if (target.closest('[data-menu-open]')) {
          e.preventDefault();
          e.stopPropagation();
          open();
          return;
        }
        const d = menu();
        if (!d?.open || !d.contains(target)) return;
        // The backdrop: a click outside the panel lands on the dialog element itself.
        if (target === d || target.closest('[data-menu-close]')) {
          close();
          return;
        }
        // "Search the site": the menu closes first, then the search dialog opens, so the two
        // modals never hold focus at once. A modified click still opens /search/ in a new tab.
        if (target.closest('[data-menu-search]')) {
          const me = e as MouseEvent;
          if (me.ctrlKey || me.metaKey || me.shiftKey) return;
          e.preventDefault();
          // The search dialog's own click listener would read this click as "a link inside the
          // open dialog" and shut it again the moment it opened.
          e.stopImmediatePropagation();
          close();
          window.dispatchEvent(new CustomEvent('site-search:open'));
          return;
        }
        // Any other link closes the menu as it is followed.
        if (target.closest('a')) close();
      },
      true,
    );

    // Keep the trigger's state right whichever way the menu closed (X, Escape, backdrop, a link).
    document.addEventListener(
      'close',
      (e) => {
        if ((e.target as Element)?.matches?.('dialog[data-menu]')) {
          trigger()?.setAttribute('aria-expanded', 'false');
        }
      },
      true,
    );

    // Close as a View Transitions navigation starts (Back or Forward too), so the page behind is
    // not left inert under the swap.
    document.addEventListener('astro:before-preparation', close);
    document.addEventListener('astro:page-load', upgrade);
  }
  upgrade();
</script>

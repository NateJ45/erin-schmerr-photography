---
// scaffold-file: sessions
// Safe to edit by hand
// Page-builder block `heirloomsSpec` (sessionSections.ts): prints, albums and
// wall pieces, each set like a gallery spec sheet (modelled on an object
// maker's product page, with no cart and no price): the kind in brackets, the
// name large in the display face, a sentence, then ruled "(Paper)", "(Size)",
// "(Finish)" rows, label left and value right. The photos stack in the picture
// track of the shared split (.split, card 91) instead of the reference's
// sideways slider, so nothing moves on its own and every photo is reachable
// without a control. From 64rem the spec sheet stays in view while its photos
// pass. A piece with no photos shows one placeholder frame.
//
// SELF_CONTAINED: plain page ground, no surface prop.
import FocusImage from '@/components/portfolio/FocusImage.astro';
import type { ProjectedHeirloomsSpecSection } from '@/lib/pageBuilder.types';
import type { PortfolioPhoto } from '@/lib/portfolio';
import '@/styles/page-sessions.css';

type Props = Omit<ProjectedHeirloomsSpecSection, '_type' | '_key'> & { headingId?: string };

const { eyebrow, heading = 'Heirlooms', intro, pieces, headingId = 'heirlooms' } = Astro.props;
const items = (pieces ?? []).filter((p) => p?.name);
---

{items.length > 0 && (
  <section class="bg-background" aria-labelledby={headingId}>
    <div class="mx-auto max-w-content px-m py-section-lg">
      <header class="sx-head">
        {eyebrow && <p class="portfolio-label mb-4">{eyebrow}</p>}
        <h2 id={headingId} class="font-display text-h2">
          {heading}
        </h2>
        {intro && <p class="mt-4 max-w-xl text-muted-foreground">{intro}</p>}
      </header>
      <div class="sx-heirlooms">
        {items.map((piece, i) => {
          const photos = (piece.photos ?? []).filter(Boolean);
          const specs = (piece.specs ?? []).filter((s) => s?.label);
          return (
            <article class="sx-piece split" aria-labelledby={`${headingId}-p${i + 1}`}>
              <div class="sx-piece__sheet">
                {piece.kind && <p class="sx-piece__kind">({piece.kind})</p>}
                <h3 id={`${headingId}-p${i + 1}`} class="sx-piece__name font-display">
                  {piece.name}
                </h3>
                {piece.body && <p class="mt-4 max-w-md text-muted-foreground">{piece.body}</p>}
                {specs.length > 0 && (
                  <dl class="sx-spec">
                    {specs.map((s) => (
                      <div class="sx-spec__row">
                        <dt>({s.label})</dt>
                        <dd class="font-display">{s.value || ''}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
              <div class="sx-piece__photos">
                {photos.length > 0 ? (
                  photos.map((p) => (
                    <FocusImage
                      photo={p as PortfolioPhoto}
                      width={900}
                      sizes="(min-width: 64rem) 40vw, 100vw"
                      crop={4 / 5}
                      alt={p.alt ?? ''}
                    />
                  ))
                ) : (
                  <FocusImage photo={null} width={900} crop={4 / 5} alt="" />
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

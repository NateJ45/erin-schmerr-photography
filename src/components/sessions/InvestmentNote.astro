---
// scaffold-file: sessions
// Safe to edit by hand
// Page-builder block `investmentNote` (sessionSections.ts): a short, warm note
// in two columns on the shared split (.split, card 91): the heading large in
// the text track, the note in the other, set a size up from body text, and an
// optional signature in the display italic (no script font). It carries no
// figure of its own: prices live only in the sittings' "Investment from" field.
//
// SELF_CONTAINED: plain page ground, no surface prop.
import PortableText from '@/components/PortableText';
import type { PortableTextBlock } from '@portabletext/types';
import '@/styles/page-sessions.css';

interface Props {
  eyebrow?: string;
  heading?: string;
  body?: PortableTextBlock[] | null;
  signature?: string;
  headingId?: string;
}

const {
  eyebrow,
  heading = 'A note on investment',
  body,
  signature,
  headingId = 'investment-note',
} = Astro.props;
const hasBody = Array.isArray(body) && body.length > 0;
---

{hasBody && (
  <section class="bg-background" aria-labelledby={headingId}>
    <div class="sx-note split mx-auto max-w-content px-m py-section-lg">
      <div>
        {eyebrow && <p class="portfolio-label mb-4">{eyebrow}</p>}
        <h2 id={headingId} class="sx-note__title font-display">
          {heading}
        </h2>
      </div>
      <div class="sx-note__body">
        <PortableText value={body as PortableTextBlock[]} />
        {signature && (
          <p class="sx-note__sign">
            <span class="portfolio-label">Signed,</span>
            <span class="sx-note__name font-display">{signature}</span>
          </p>
        )}
      </div>
    </div>
  </section>
)}

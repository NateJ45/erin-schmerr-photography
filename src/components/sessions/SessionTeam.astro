---
// scaffold-file: sessions
// Safe to edit by hand
// Page-builder block `sessionTeam` (sessionSections.ts, phase 2, 2026-11-20):
// the people who work beside her, credited like a magazine masthead. On the
// shared split (.split, card 91): the heading, a sentence and an optional
// photo of the team at work in the text track; the credits in the other, one
// ruled row each, the role small and tracked, the name very large in the
// display face and a line about them. A row with a link (the collaborator's
// site, else their Instagram) inverts to ink on hover and focus, like a credit
// list in print turned into a contents page.
//
// The names come from Collaborators, the same list story credits use
// (queries.ts projects `person` from the reference), so a name is typed once.
// A row whose collaborator is missing is left out.
//
// SELF_CONTAINED: plain page ground, no surface prop.
import FocusImage from '@/components/portfolio/FocusImage.astro';
import type { ProjectedSessionTeamSection } from '@/lib/pageBuilder.types';
import type { PortfolioPhoto } from '@/lib/portfolio';
import '@/styles/page-sessions.css';

type Props = Omit<ProjectedSessionTeamSection, '_type' | '_key'> & { headingId?: string };

const {
  eyebrow,
  heading = 'The team',
  intro,
  photo,
  members,
  headingId = 'session-team',
} = Astro.props;
const people = (members ?? []).filter((m) => m?.person?.name);
const linkOf = (p: { url?: string; instagram?: string } | null | undefined) =>
  p?.url || (p?.instagram ? `https://www.instagram.com/${p.instagram}/` : '');
---

{people.length > 0 && (
  <section class="bg-background" aria-labelledby={headingId}>
    <div class="sx-team split mx-auto max-w-content px-m py-section-lg">
      <div class="sx-team__head">
        {eyebrow && <p class="portfolio-label mb-4">{eyebrow}</p>}
        <h2 id={headingId} class="sx-big-title font-display">
          {heading}
        </h2>
        {intro && <p class="mt-6 max-w-md text-lg text-muted-foreground">{intro}</p>}
        {photo?.asset && (
          <FocusImage
            photo={photo as PortfolioPhoto}
            width={900}
            sizes="(min-width: 64rem) 30vw, 100vw"
            crop={3 / 2}
            alt={photo.alt ?? ''}
            class="sx-team__photo"
          />
        )}
      </div>
      <ul class="sx-team__list" role="list">
        {people.map((m) => {
          const href = linkOf(m.person);
          const inner = (
            <>
              <span class="sx-credit__role portfolio-label">{m.role}</span>
              <span class="sx-credit__name font-display">{m.person?.name}</span>
              {m.line && <span class="sx-credit__line">{m.line}</span>}
            </>
          );
          return (
            <li class="sx-credit">
              {href ? (
                <a class="sx-credit__body" href={href} rel="noopener" target="_blank">
                  {inner}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                <div class="sx-credit__body">{inner}</div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

---
// scaffold-file: sessions
// Safe to edit by hand
// Page-builder block `sessionExperience` (sessionSections.ts): how a session
// goes, as a tall photo pinned in the picture track of the shared split
// (.split--media-first, card 91) while the numbered steps scroll past in the
// text track. The step crossing the middle of the screen is lit (ink, with a
// short rule on the line that runs down the steps); the others rest in muted
// ink. Modelled on a dark chronology with a pinned photo, turned to paper.
//
// The pinned version is switched on by the script below, which sets
// `data-scrolly` only under html.motion (no reduced motion, JavaScript on) and
// from 64rem up. Without it, which is the markup as served, the block is a
// plain ordered list beside the photo: every step in full ink, nothing pinned,
// nothing dimmed. Native scrolling throughout (rule 5); no scroll library.
//
// SELF_CONTAINED: plain page ground, no surface prop.
import FocusImage from '@/components/portfolio/FocusImage.astro';
import type { ProjectedSessionExperienceSection } from '@/lib/pageBuilder.types';
import type { PortfolioPhoto } from '@/lib/portfolio';
import '@/styles/page-sessions.css';

type Props = Omit<ProjectedSessionExperienceSection, '_type' | '_key'> & { headingId?: string };

const {
  eyebrow,
  heading = 'The experience',
  photo,
  steps,
  headingId = 'session-experience',
} = Astro.props;
const rows = (steps ?? []).filter((s) => s?.title);
const pad = (n: number) => String(n).padStart(2, '0');
---

{rows.length > 0 && (
  <section class="sx-exp bg-background" aria-labelledby={headingId} data-sx-experience>
    <div class="split split--media-first mx-auto max-w-content px-m py-section-lg">
      <div class="sx-exp__media">
        <FocusImage
          photo={photo as PortfolioPhoto}
          width={900}
          sizes="(min-width: 64rem) 40vw, 100vw"
          crop={4 / 5}
          alt={photo?.alt ?? ''}
          class="sx-exp__photo"
        />
      </div>
      <div class="sx-exp__text">
        {eyebrow && <p class="portfolio-label mb-4">{eyebrow}</p>}
        <h2 id={headingId} class="font-display text-h2">
          {heading}
        </h2>
        <ol class="sx-exp__steps list-none" role="list">
          {rows.map((step, i) => (
            <li class="sx-step" data-sx-step>
              <span class="sx-step__n portfolio-label" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <h3 class="sx-step__title font-display">
                <span class="sr-only">Step {i + 1}: </span>
                {step.title}
              </h3>
              {step.body && <p class="sx-step__body text-muted-foreground">{step.body}</p>}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
)}

<script>
  // Lights the step crossing the middle of the screen. Bound once per block;
  // re-checked on Astro's page-load so a client-side visit works too.
  const WIDE = '(min-width: 64rem)';

  function initExperience() {
    const motion = document.documentElement.classList.contains('motion');
    document.querySelectorAll<HTMLElement>('[data-sx-experience]').forEach((block) => {
      if (block.dataset.bound) return;
      block.dataset.bound = '1';
      const steps = [...block.querySelectorAll<HTMLElement>('[data-sx-step]')];
      if (!motion || !('IntersectionObserver' in window) || steps.length < 2) return;

      const wide = window.matchMedia(WIDE);
      let observer: IntersectionObserver | null = null;

      const light = (step: HTMLElement) => {
        for (const s of steps) {
          const on = s === step;
          s.toggleAttribute('data-lit', on);
          if (on) s.setAttribute('aria-current', 'step');
          else s.removeAttribute('aria-current');
        }
      };

      const start = () => {
        block.setAttribute('data-scrolly', '');
        light(steps[0]);
        // A thin band across the middle of the screen: whichever step is in it is lit.
        observer = new IntersectionObserver(
          (entries) => {
            const hit = entries.find((e) => e.isIntersecting);
            if (hit) light(hit.target as HTMLElement);
          },
          { rootMargin: '-45% 0px -45% 0px' },
        );
        steps.forEach((s) => observer!.observe(s));
      };

      const stop = () => {
        observer?.disconnect();
        observer = null;
        block.removeAttribute('data-scrolly');
        for (const s of steps) {
          s.removeAttribute('data-lit');
          s.removeAttribute('aria-current');
        }
      };

      const sync = () => (wide.matches ? start() : stop());
      sync();
      wide.addEventListener('change', () => {
        stop();
        sync();
      });
    });
  }

  initExperience();
  document.addEventListener('astro:page-load', initExperience);
</script>

---
// scaffold-file: sessions
// Safe to edit by hand
// Page-builder block `sessionsClose` (sessionSections.ts, phase 2,
// 2026-11-20): the Sessions page's last band and its one booking ask. One
// short word ("Begin") set across the whole content column, cut out of the
// paper so one of her photos shows through the letters (background-clip:
// text, the home cinema's knockout), then on the shared split (.split, card
// 91) the heading "Reserve a complimentary consultation", a sentence, the
// page's one filled Dusk button and a small line on how soon she replies.
//
// The word is decorative (aria-hidden, data-contrast-decorative, and plain ink
// in print); the heading is the real text. Its size comes from its length and
// the column (container units), so it never scrolls sideways. Without a photo
// the letters fill with a Dusk-to-ink wash.
//
// It counts as the page's own closing invitation ([data-final-cta]), so the
// footer leaves its invitation out here, and SectionRenderer gives it the
// page's one accent button (card 158).
//
// SELF_CONTAINED: plain page ground, no surface prop.
import type { ProjectedSessionsCloseSection } from '@/lib/pageBuilder.types';
import { ctaHref } from '@/lib/cta-href';
import { urlFor } from '@/lib/sanity';
import '@/styles/page-sessions.css';

type Props = Omit<ProjectedSessionsCloseSection, '_type' | '_key'> & {
  headingId?: string;
  primaryVariant?: 'primary' | 'secondary';
};

const {
  eyebrow,
  word,
  photo,
  heading = 'Reserve a complimentary consultation',
  body,
  cta,
  replyNote,
  headingId = 'sessions-close',
  primaryVariant = 'primary',
} = Astro.props;
const big = (word ?? '').trim();
const fill = photo?.asset ? urlFor(photo).width(1800).fit('max').auto('format').url() : null;
const wordStyle = [`--len: ${Math.max(big.length, 3)}`, fill ? `--knock-fill: url("${fill}")` : '']
  .filter(Boolean)
  .join('; ');
const href = ctaHref(cta, '/contact/');
const label = cta?.label || 'Reserve a consultation';
---

<section class="bg-background" aria-labelledby={headingId} data-final-cta>
  <div class="sx-close mx-auto max-w-content px-m py-section-lg">
    {big && (
      <p
        class="sx-close__word sx-knock font-display"
        aria-hidden="true"
        data-contrast-decorative
        style={wordStyle}
      >
        {big}
      </p>
    )}
    <div class="sx-close__body split">
      <div>
        {eyebrow && <p class="portfolio-label mb-4">{eyebrow}</p>}
        <h2 id={headingId} class="sx-close__title font-display">
          {heading}
        </h2>
      </div>
      <div class="sx-close__note">
        {body && <p class="text-lg text-muted-foreground">{body}</p>}
        <p class="mt-8">
          <a
            class:list={['sx-button', primaryVariant === 'primary' && 'sx-button--primary']}
            href={href}
          >
            {label}
          </a>
        </p>
        {replyNote && <p class="sx-close__reply portfolio-label">{replyNote}</p>}
      </div>
    </div>
  </div>
</section>

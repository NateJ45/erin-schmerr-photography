---
// Safe to edit by hand
// Page-builder block (card 190, ported from FBC Auburn): "Contact form". On this site it is the
// booking request (2026-11-20, src/components/booking/BookingForm.astro, DESIGN.md "Booking
// request"): four chapters beside her portrait, then "Thank you" and what happens next. It
// replaced the starter's React form, its map and its details column; the form still sends
// through the same backend (/api/contact/, PORTS.md card 45).
//
// The form's own settings (the sittings, the portrait, the thank-you note, the availability
// line) stay on the Contact page document, tab "Form intro + expectations". Two callers, one
// markup:
//   - contact.astro with an EMPTY Page layout passes the whole contactPage document as
//     `settings` and the hero words, so the block carries the page's h1.
//   - SectionRenderer passes the `settings` the GROQ arm in queries.ts (SECTION_ARMS) read from
//     the Contact page, and the block heads itself with an h2 under the page's hero block.
// The business's email comes from Site settings.
import { getSiteSettings } from '@/lib/queries';
import BookingForm from '@/components/booking/BookingForm.astro';
import type { ContactFormSettings } from '@/lib/pageBuilder.types';
import type { PortfolioPhoto } from '@/lib/portfolio';
import { getFeaturedStories } from '@/lib/storyQueries'; // scaffold: stories

interface Props {
  settings?: ContactFormSettings | null;
  /** Show her portrait beside the form (default yes). */
  sidebar?: boolean;
  /** The classic Contact page passes its hero words; the block then carries the h1. */
  eyebrow?: string | null;
  heading?: string | null;
  subhead?: string | null;
  headingLevel?: 'h1' | 'h2';
}
const { settings, sidebar = true, eyebrow, heading, subhead, headingLevel = 'h2' } = Astro.props;
const siteSettings = await getSiteSettings();

// Her story covers stand in for the sittings' and portrait's pictures until she adds her own.
let covers: PortfolioPhoto[] = [];
// scaffold: stories
covers = (await getFeaturedStories(4)).map((s) => s.cover).filter((c): c is PortfolioPhoto => !!c);
// scaffold:end
---

<BookingForm
  settings={settings}
  covers={covers}
  email={siteSettings?.email}
  portrait={sidebar}
  eyebrow={eyebrow ?? 'Complimentary consultation'}
  heading={heading}
  subhead={subhead}
  headingLevel={headingLevel}
/>

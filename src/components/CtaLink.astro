---
import { ctaHref } from '@/lib/cta-href';
import '@/styles/cta.css';
// Safe to edit by hand
// Resolves a Sanity ctaBlock to the right <a href>:
//   - internal: maps the referenced page _type to its route (homePage → /, etc.)
//   - external: passes through the URL, opens in new tab by default
//   - email: builds a mailto: link
//   - phone: builds a tel: link
//
// Two visual variants + a tone modifier (this site's button family, below):
//   - "primary": the one filled Dusk button.
//   - "secondary": the outlined ink button.
//   - `onDark`: for a CTA over a photograph; paper outline and text. Use it rather than a
//     `class` override to recolour.
//
// Both variants share small tracked capitals and a 44px minimum tap target.

interface CtaBlock {
  label?: string;
  linkType?: 'internal' | 'external' | 'email' | 'phone';
  internalLink?: { _type?: string; slug?: string } | null;
  externalUrl?: string;
  emailAddress?: string;
  phoneNumber?: string;
  openInNewTab?: boolean;
  /** A plain path. Only the built-in default sections (src/data/defaultSections.ts) use it;
      Studio buttons always carry a linkType. */
  href?: string;
}

interface Props {
  cta?: CtaBlock | null;
  variant?: 'primary' | 'secondary';
  /** When true, swap variant colors for legibility on a dark surface. */
  onDark?: boolean;
  /** Fallback href if the CTA can't be resolved (e.g., siteSettings hasn't been populated). */
  fallbackHref?: string;
  /** Fallback label if cta.label is missing. */
  fallbackLabel?: string;
  class?: string;
}

const {
  cta,
  variant = 'primary',
  onDark = false,
  fallbackHref = '/contact/',
  fallbackLabel = 'Get in touch',
  class: extraClass = '',
} = Astro.props as Props;

// A button object with nothing filled in (an optional button left empty) draws nothing, rather
// than the fallback label. No cta at all still takes the fallbacks.
const isEmpty = cta != null && !cta.label && !cta.linkType && !cta.href;
const href = ctaHref(cta, fallbackHref);
const label = cta?.label ?? fallbackLabel;
const isExternal = cta?.linkType === 'external';
const newTab = cta?.openInNewTab || isExternal;

// THIS SITE'S BUTTON FAMILY (2026-11-20, "no starter left"; styles in src/styles/cta.css). The
// starter's pressable rounded pill and bronze outline are gone: every CtaLink is now square,
// small tracked Jost capitals, no shadow, no press scale.
//   primary    the page's one filled Dusk button (paper on Dusk, 6.3:1); fills with ink on hover.
//   secondary  the header's outlined ink button (`.bq-button` look); fills with ink on hover.
//   onDark     the same over a photograph: paper outline and paper text.
const baseClasses = 'tate-cta';
const variantClasses =
  variant === 'primary'
    ? onDark
      ? 'tate-cta--primary tate-cta--on-dark'
      : 'tate-cta--primary'
    : onDark
      ? 'tate-cta--secondary tate-cta--on-dark'
      : 'tate-cta--secondary';
---

{!isEmpty && (
  <a
    href={href}
    class:list={[baseClasses, variantClasses, extraClass]}
    target={newTab ? '_blank' : undefined}
    rel={newTab ? 'noopener noreferrer' : undefined}
  >
    {label}
  </a>
)}

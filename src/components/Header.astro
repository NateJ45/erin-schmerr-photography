---
// Foundation, edit with care
// Site header: "the jewel masthead" (DESIGN.md, Components; 2026-11-20), built on the same
// day's "boutique bar", which replaced the darkroom film-leader strip of 2026-11-18.
//
//   ┌──────────────────────────────────────────────────────────────────────────┐
//   │ Tate Fine Art Photography   Cincinnati          Stories Archive …  ⌕  [Get in touch] │
//   │                             West Chester, Ohio                                       │
//   └──────────────────────────────────────────────────────────────────────────┘
// A thin bar on warm paper (after M. Fisher): the wordmark, a small two-line serif place
// block beside it (Business info's service areas and state, src/lib/place-block.ts), the
// nav in small Jost, and "Get in touch" as an outlined square button (the
// label typed in Site settings wins). Hovering or focusing one nav link dims the others
// (after Quadplex 80); the page you are on carries a hairline under its name.
//
// The jewel masthead (2026-11-20, Nathan: "a more visually impressive header"): the
// wordmark runs larger at rest; each nav link ROLLS on hover, its small tracked capitals
// lifting away as the same word in Bodoni italic rises in, while a magenta rule draws under
// it (the italic swap is Radaville's, details.so/inspo/radaville-uugkpt); "Get in touch"
// fills with wine from below; and a "Menu" button with a rolling label and a turning mark
// opens the full-screen jewel menu (MobileNav.astro) at every width. Over the home page's
// cinema the bar is see-through: paper words on the photo under a soft scrim, the paper
// wordmark (logo-dark.svg) in place of the ink one. Once the opening frame has scrolled up
// under it the bar turns solid paper again (data-over, set by the script at the foot).
//
// Rule 4: every link is server-rendered here, dropdown groups are native <details>.
// Scrolling down hides the bar (BaseLayout sets data-state="hidden"); scrolling up brings
// it back, compacted a little (data-scrolled, below). Transforms only, so nothing under
// it moves. The root keeps the class `site-header`: the home hero's opening hides and
// fades the bar by that class. Below lg the row is the wordmark, search and the "Menu"
// button (MobileNav.astro); from lg the nav, search and "Get in touch" come before "Menu". Styles: src/styles/chrome-header.css.
//
// siteSettings is optional. Defaults render cleanly before Sanity is wired up.

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import MobileNav from './MobileNav.astro';
import { ChevronDown } from 'lucide-react';
import logoLightAsset from '@/assets/logo-light.svg';
import logoDarkAsset from '@/assets/logo-dark.svg';
import { publicPath } from '@/lib/page-path';
import { mergePageSwitches } from '@/lib/page-switches';
import { getNavPages } from '@/lib/queries';
import { resolveSiteSettings, type RawChromeSettings } from '@/lib/siteSettings';
import { phoneMenuGroups } from '@/lib/wayfinding';
import { placeBlockLines } from '@/lib/place-block';
import { urlFor } from '@/lib/sanity';
import SearchButton from './search/SearchButton.astro';
import SiteSearch from './search/SiteSearch.astro';
import { getDarkroomData } from './darkroom/chrome-data';

// SVG logos go through Astro's image pipeline for cache-busted URLs.
const logoLightImg = await getImage({ src: logoLightAsset });
const logoDarkImg = await getImage({ src: logoDarkAsset });
const logoLightSrcset = logoLightImg.src;
const logoDarkSrcset = logoDarkImg.src;

interface Props {
  siteSettings?:
    | (RawChromeSettings & {
        siteName?: string;
        title?: string;
        tagline?: string;
        email?: string;
        phone?: string;
        socialInstagram?: string;
        socialFacebook?: string;
        availabilityStatus?: string;
        serviceAreas?: (string | null)[] | null;
        city?: string | null;
        state?: string | null;
      })
    | null;
}

const { siteSettings } = Astro.props as Props;

const brandName = siteSettings?.siteName ?? siteSettings?.title ?? site.name;

// The chrome resolves through one shared helper so header, menu and footer agree.
const chrome = resolveSiteSettings(siteSettings);
// The inquiry button. This site's own default reads "Get in touch"; a label typed in
// Site settings still wins.
const headerCta = {
  ...chrome.headerCta,
  label: siteSettings?.headerCta?.label?.trim() ? chrome.headerCta.label : 'Get in touch',
};
// Card 191: Site settings > Phone menu groups. Empty keeps the menu's one list.
const phoneGroups = phoneMenuGroups(
  siteSettings?.phoneMenuGroups,
  headerCta.show ? headerCta.href : undefined,
);
const headerSecondary = chrome.headerSecondary;
const logo = chrome.logo;
// Built with urlFor() rather than <SanityImage>: the header renders on every page.
const logoSrc = logo ? urlFor(logo).width(280).quality(80).auto('format').url() : undefined;
const logoSrcset = logo
  ? [280, 560]
      .map((w) => `${urlFor(logo).width(w).quality(80).auto('format').url()} ${w}w`)
      .join(', ')
  : undefined;

// The small place block beside the wordmark: derived from Business info (rule 15).
const placeLines = placeBlockLines({
  serviceAreas: siteSettings?.serviceAreas,
  city: siteSettings?.city,
  state: siteSettings?.state,
});

const mobileNavSettings = siteSettings
  ? {
      tagline: siteSettings.tagline,
      email: chrome.showEmail ? siteSettings.email : undefined,
      phone: siteSettings.phone,
      socialInstagram: chrome.showSocials ? siteSettings.socialInstagram : undefined,
      socialFacebook: chrome.showSocials ? siteSettings.socialFacebook : undefined,
    }
  : null;

// The menu from Sanity (Site settings > Navigation), plus pages switched into it (card 187).
const NAV_ITEMS = mergePageSwitches(chrome.headerNav, [], await getNavPages()).nav;

// The phone menu's photo frame: her featured story covers (read once per build).
const chromeData = await getDarkroomData();

const pathname = publicPath(Astro.url.pathname);
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href.endsWith('/') ? href : `${href}/`);
}
function isGroupActive(items: { href: string }[]) {
  return items.some((item) => isActive(item.href));
}
---

<header class="site-header bq-header bg-background">
  <div class="site-header__row bq-header__row relative mx-auto flex max-w-content items-center">
    <div class="bq-header__brand">
      <a
        href="/"
        class="site-header__logo bq-header__logo inline-flex items-center"
        aria-label={`${brandName} home`}
      >
        {/* One theme-aware logo: no src until the inline script below picks the
            variant, so only one file is fetched. 280x60 reserves the box (no CLS). */}
        {logo ? (
          <img
            src={logoSrc}
            srcset={logoSrcset}
            sizes="280px"
            alt={logo.alt || brandName}
            class="h-12 w-auto"
            loading="eager"
            decoding="async"
          />
        ) : (
          <img
            alt={brandName}
            width={280}
            height={60}
            class="h-12 w-auto"
            loading="eager"
            decoding="async"
            data-theme-logo
            data-logo-light-src={logoLightImg.src}
            data-logo-light-srcset={logoLightSrcset}
            data-logo-dark-src={logoDarkImg.src}
            data-logo-dark-srcset={logoDarkSrcset}
          />
        )}
        {/* The paper wordmark for the bar over the home cinema (data-over). Lazy: a page
            with no cinema never shows it, so never fetches it. */}
        {!logo && (
          <img
            src={logoDarkImg.src}
            alt=""
            width={280}
            height={60}
            class="bq-header__logo-over h-12 w-auto"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        )}
        {/* No-JS fallback (card 108): the light variant. */}
        {!logo && (
          <noscript>
            <img
              src={logoLightImg.src}
              alt={brandName}
              width={280}
              height={60}
              class="h-12 w-auto"
              decoding="async"
            />
          </noscript>
        )}
      </a>
      <script is:inline>
        (function () {
          const img = document.querySelector('header img[data-theme-logo]');
          if (!img) return;
          const dark = document.documentElement.classList.contains('dark');
          img.src = dark ? img.dataset.logoDarkSrc : img.dataset.logoLightSrc;
          img.srcset = dark ? img.dataset.logoDarkSrcset : img.dataset.logoLightSrcset;
        })();
      </script>

      {/* The place block (lg+): where she works, in two small serif lines. */}
      {placeLines.length > 0 && (
        <p class="bq-place">
          {placeLines.map((line) => (
            <span>{line}</span>
          ))}
        </p>
      )}
    </div>

    {/* Desktop (lg+): the nav, search and the inquiry button. */}
    <div class="site-header__nav bq-header__nav hidden items-center lg:flex">
      <nav class="site-nav bq-nav" aria-label="Primary">
        {NAV_ITEMS.map((item) =>
          item.kind === 'flat' ? (
            <a
              href={item.href}
              class="bq-nav__link"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="bq-roll">
                <span class="bq-roll__a">{item.label}</span>
                <span class="bq-roll__b" aria-hidden="true">
                  {item.label}
                </span>
              </span>
            </a>
          ) : (
            <details class="site-nav__group bq-nav__group relative">
              <summary
                class="bq-nav__link"
                aria-current={isGroupActive(item.items) ? 'page' : undefined}
              >
                <span class="bq-roll">
                  <span class="bq-roll__a">{item.label}</span>
                  <span class="bq-roll__b" aria-hidden="true">
                    {item.label}
                  </span>
                </span>
                <ChevronDown
                  size={12}
                  className="site-nav__chevron transition-transform duration-150"
                  aria-hidden="true"
                />
              </summary>
              <div class="site-nav__menu bq-nav__menu absolute top-full left-0 z-50 min-w-[200px]">
                {item.items.map((sub) => (
                  <a
                    href={sub.href}
                    class="bq-nav__sub"
                    aria-current={isActive(sub.href) ? 'page' : undefined}
                  >
                    {sub.label}
                  </a>
                ))}
              </div>
            </details>
          ),
        )}
      </nav>
      {/* Visitor search (card 126). Renders nothing when search is off. */}
      <SearchButton class="bq-icon-button" size={17} />
      {headerSecondary && (
        <a
          href={headerSecondary.href}
          class="bq-nav__link bq-nav__link--secondary"
          aria-current={isActive(headerSecondary.href) ? 'page' : undefined}
        >
          <span class="bq-roll">
            <span class="bq-roll__a">{headerSecondary.label}</span>
            <span class="bq-roll__b" aria-hidden="true">
              {headerSecondary.label}
            </span>
          </span>
        </a>
      )}
      {headerCta.show && (
        <a
          href={headerCta.href}
          class="bq-button bq-button--flood"
          aria-current={isActive(headerCta.href) ? 'page' : undefined}
        >
          <span>{headerCta.label}</span>
        </a>
      )}
    </div>

    {/* Search below lg, then the "Menu" button at every width, at the right of the row. */}
    <div class="bq-header__end">
      <div class="bq-header__phone lg:hidden">
        <SearchButton class="bq-icon-button" size={18} />
      </div>
      <MobileNav
        search={site.search.enabled}
        links={NAV_ITEMS}
        siteSettings={mobileNavSettings}
        brandName={brandName}
        cta={headerCta}
        secondary={headerSecondary}
        groups={phoneGroups}
        current={pathname}
        frames={chromeData.covers}
        pagePrints={chromeData.pagePrints}
        logoSrc={logoDarkImg.src}
        place={placeLines}
      />
    </div>
  </div>
  {site.search.enabled && <SiteSearch />}
</header>

<style>
  /* The theme-aware logo only lacks a src when the inline swap script never
     ran (JS off); the <noscript> copy shows instead (card 108). */
  img[data-theme-logo]:not([src]) {
    display: none;
  }

  /* Desktop dropdown groups (native <details>). The links are server-rendered
     and fully usable with no JS; these styles + the script below add the
     dropdown affordances. */

  /* Hide the default disclosure triangle in every engine. */
  .site-nav__group > summary {
    list-style: none;
  }
  .site-nav__group > summary::-webkit-details-marker,
  .site-nav__group > summary::marker {
    display: none;
    content: '';
  }

  /* Rotate the chevron when the group is open. */
  .site-nav__group[open] > summary .site-nav__chevron {
    transform: rotate(180deg);
  }

  /* The menu panel starts hidden until the <details> is open. <details>
     natively hides non-summary children when closed, but we keep an explicit
     rule so the absolutely-positioned panel never flashes during hydration. */
  .site-nav__menu {
    display: none;
  }
  .site-nav__group[open] > .site-nav__menu {
    display: block;
  }
</style>

{/* Progressive enhancement for the desktop dropdown nav. Everything still
    works without this (native <details> toggles on click/Enter/Space, links
    are real <a> tags). This adds one dropdown model (card 157): open-on-hover
    for a mouse with a 300ms close delay (a click on a label hover has opened
    keeps it open), close-on-outside-click, close-on-Escape with focus back on
    the label, and close-when-a-link-is-followed.
    Re-binds on astro:page-load so it survives View Transitions navigations. */}
<script>
  // Query groups fresh each call — the nav DOM is replaced on every View
  // Transitions navigation, so a captured list would go stale.
  function currentGroups() {
    return Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-nav__group'));
  }

  function closeAllGroups(except?: HTMLDetailsElement) {
    for (const g of currentGroups()) {
      if (g !== except) g.open = false;
    }
  }

  function initHeaderNav() {
    const groups = currentGroups();
    if (groups.length === 0) return;

    const closeAll = closeAllGroups;

    for (const group of groups) {
      const summary = group.querySelector('summary');
      let closeTimer: number | undefined;

      const cancelClose = () => {
        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = undefined;
        }
      };

      // One model, so hover and click never fight (card 157). A mouse opens a
      // group by hovering, and it stays open while the pointer is over the
      // label or the panel. Clicking the label of a group hover has just opened
      // keeps it open (it used to toggle the <details> shut under the cursor);
      // a second click closes it. Leaving starts a 300ms close, long enough for
      // a diagonal path from the label to a link, cancelled the moment the
      // pointer comes back. Touch and keyboard skip all of this: a tap, Enter
      // or Space toggles the native <details>.
      let openedByHover = false;
      group.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        if (group.open) return;
        closeAll(group);
        group.open = true;
        openedByHover = true;
      });
      group.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeTimer = window.setTimeout(() => {
          group.open = false;
          openedByHover = false;
        }, 300);
      });

      summary?.addEventListener('click', (e) => {
        // A mouse click on a label hover has already opened: keep it open, once.
        // (e.detail is 0 for Enter or Space, so the keyboard always toggles.)
        if (group.open && openedByHover && e.detail > 0) {
          e.preventDefault();
          openedByHover = false;
          return;
        }
        openedByHover = false;
        // <details> toggles AFTER this handler, so the post-toggle state is the
        // inverse of the current one. If it's about to open, close the rest.
        if (!group.open) closeAll(group);
      });

      // Following a link inside the menu should close the group (so it isn't
      // left open behind the next page during a View Transitions swap).
      group.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          group.open = false;
        });
      });
    }
  }

  // Document-level listeners bind ONCE (guarded by a window flag), so they
  // don't stack up across View Transitions navigations. They query the nav
  // groups fresh each time they fire, so the swapped-in DOM is always covered.
  const w = window as typeof window & { __headerNavBound?: boolean };
  if (!w.__headerNavBound) {
    w.__headerNavBound = true;

    // Close any open group when clicking outside the nav.
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node;
      if (!currentGroups().some((g) => g.contains(target))) closeAllGroups();
    });

    // Escape closes the open group and returns focus to its summary.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openGroup = currentGroups().find((g) => g.open);
      if (openGroup) {
        openGroup.open = false;
        openGroup.querySelector('summary')?.focus();
      }
    });
  }

  initHeaderNav();
  document.addEventListener('astro:page-load', initHeaderNav);
</script>

{/* Header compaction (card 157). data-scrolled: the page has moved, so the bar
    compacts. From lg up the accent stripe and eyebrow strip slide up out of
    view and the main row tightens, all with transforms (globals.css, "Header
    compaction"), so the bar keeps its layout height and nothing under it
    reflows. Two thresholds, not one: it compacts past 64px and opens again only
    at 8px or less, so a small scroll jitter near the top (or the browser's
    scroll anchoring) cannot flip it every few frames and shake the bar. The
    global reduced-motion reset makes the change instant. */}
<script>
  const COMPACT_AT = 64;
  const OPEN_AT = 8;

  // How far the bar slides up when compact: the stripe plus the eyebrow strip
  // (0 below lg, where the strip is display:none). Measured, not hard-coded,
  // so a taller eyebrow (a long tagline, a phone number) still clears fully.
  const measureHeader = () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    const row = header?.querySelector<HTMLElement>('.site-header__row');
    if (!header || !row) return;
    header.style.setProperty('--hdr-top', `${row.offsetTop}px`);
  };

  const updateHeaderState = () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    const y = window.scrollY;
    if (y > COMPACT_AT) header.setAttribute('data-scrolled', '');
    else if (y <= OPEN_AT) header.removeAttribute('data-scrolled');
    // The jewel masthead over the home cinema: see-through while the opening frame is still
    // under the bar, solid paper once it has scrolled up past it. The CSS pulls the cinema up
    // under the bar (chrome-header.css, "Over the cinema"); with JavaScript off the bar stays
    // solid paper there, which still reads.
    const open = document.querySelector<HTMLElement>('.cinema-open');
    const over = !!open && open.getBoundingClientRect().bottom > header.offsetHeight + 1;
    header.toggleAttribute('data-over', over);
  };

  const hw = window as typeof window & { __headerStateBound?: boolean };
  if (!hw.__headerStateBound) {
    hw.__headerStateBound = true;
    let queued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          updateHeaderState();
        });
      },
      { passive: true },
    );
    window.addEventListener(
      'resize',
      () => {
        measureHeader();
        updateHeaderState();
      },
      { passive: true },
    );
    document.addEventListener('astro:page-load', () => {
      measureHeader();
      updateHeaderState();
    });
  }
  measureHeader();
  updateHeaderState();
</script>

---
// scaffold-file: stories
// Safe to edit by hand
// /archive/: every photo kept in the archive (Show in the archive ticked, the
// default), from every story, as a plain responsive grid. Each photo links to
// its story. On a wide screen with a mouse, with motion allowed, the grid
// becomes the draggable, endlessly looping canvas (DESIGN.md "Archive canvas",
// src/scripts/archive-canvas.ts). The grid stays the markup, so touch, reduced
// motion and JavaScript-off all get it, and "View as a grid" goes back to it.
import BaseLayout from '@/layouts/BaseLayout.astro';
import FocusImage from '@/components/portfolio/FocusImage.astro';
import { getSiteSettings } from '@/lib/queries';
import { getArchivePhotos } from '@/lib/storyQueries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import '@/styles/portfolio.css';

const [photos, siteSettings] = await Promise.all([getArchivePhotos(), getSiteSettings()]);
const placeholder = photos.length > 0 && photos.every((p) => !p.asset);

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Archive', url: `${site.url}/archive/` },
  ]),
];
---

<BaseLayout
  title={`Archive | ${site.name}`}
  description="Every photograph from every one of my stories, in one place."
  {schemas}
  {siteSettings}
  ogCard={{ kicker: 'Archive' }}
>
  <section class="bg-background" aria-labelledby="archive-heading">
    {/* The masthead sits on a jewel (src/lib/jewel-cadence.ts), bled to both edges. */}
    <div class="jewel surface-jewel-amber jewel-bleed mx-auto max-w-content px-m py-section-md">
      <h1 id="archive-heading" class="font-display text-h1 leading-headline-tight">
        Archive
      </h1>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
        <p class="portfolio-label">
          {photos.length} photographs{placeholder ? ', all placeholders for now' : ''}
        </p>
        <div class="archive__controls" data-waiting>
          <span class="portfolio-label archive__hint">Drag to explore</span>
          <button type="button" class="archive__toggle" data-archive-toggle aria-pressed="true">
            View as a grid
          </button>
        </div>
      </div>
    </div>
    <div class="archive mt-section-md" data-archive>
      <div class="archive__viewport">
        <ul class="archive-grid archive__plane mx-auto max-w-content px-m list-none">
          {photos.map((photo, i) => (
            <li>
              <a
                href={`/stories/${photo.storySlug}/`}
                class="block no-underline"
                aria-label={`${photo.alt || 'Photo'}, from ${photo.storyTitle}`}
              >
                <FocusImage
                  photo={photo}
                  width={700}
                  crop={4 / 5}
                  sizes="(min-width: 80rem) 20rem, (min-width: 48rem) 33vw, 50vw"
                  loading={i < 8 ? 'eager' : 'lazy'}
                  alt=""
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '@/scripts/archive-canvas';
</script>

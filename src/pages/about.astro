---
// scaffold-file: about
// Safe to edit by hand for copy + structure changes.
// About page — section-driven via pageBuilder.
// Edit sections and order in Sanity Studio under the About Page document.
// When pageBuilder is empty (no Sanity project or unseeded), DEFAULT_ABOUT_SECTIONS
// renders so the page is never blank.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getAboutPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { personSchema, type PressFeature } from '@/lib/site-graph';
import { getPublications } from '@/lib/pressQueries'; // scaffold: press
import { pageDescription, pageTitle } from '@/lib/page-meta';
import { site } from '@/data/site';
import { DEFAULT_ABOUT_SECTIONS } from '@/data/defaultSections';

const [page, siteSettings] = await Promise.all([getAboutPage(), getSiteSettings()]);
// Her press features, for the Person's subjectOf. Filled on its own line so removing
// the press capability (npm run scaffold) leaves an empty list, not a broken import.
const press: PressFeature[] = [];
press.push(...(await getPublications())); // scaffold: press

// The Studio's SEO fields win when they hold real words (src/lib/page-meta.ts).
const title = pageTitle(page?.seoTitle, 'About Erin Schmerr');
const description = pageDescription(
  page?.seoDescription,
  'How I started with my dad’s camera, and the vintage, story-led portraits I make around Cincinnati and West Chester, Ohio.',
);

const sections = page?.pageBuilder?.length ? page.pageBuilder : DEFAULT_ABOUT_SECTIONS;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'About', url: `${site.url}/about/` },
  ]),
  personSchema(press),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  <SectionRenderer {sections} idPrefix="about" />
</BaseLayout>

---
// scaffold-file: press
// Safe to edit by hand
// /press/: every publication, grouped by the year of its date (newest first,
// undated last), set as an index: the year in a left rail that stays in view
// while its features scroll past, each feature a row with its tear sheet,
// issue and date, the magazine large, its excerpt and a link to the piece. The year is
// worked out from `date`, never typed (rule 15). With no Sanity data it shows
// the placeholder publications from src/lib/pressQueries.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import FocusImage from '@/components/portfolio/FocusImage.astro';
import { getSiteSettings } from '@/lib/queries';
import { getPublications } from '@/lib/pressQueries';
import { formatMonthYear, groupByYear } from '@/lib/portfolio';
import { breadcrumbSchema } from '@/lib/schemas';
import { personSchema } from '@/lib/site-graph';
import { site } from '@/data/site';
import '@/styles/portfolio.css';

const [publications, siteSettings] = await Promise.all([getPublications(), getSiteSettings()]);
const years = groupByYear(publications);
const placeholder = publications.every((p) => p.isPlaceholder);

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Press', url: `${site.url}/press/` },
  ]),
  // The photographer with every feature that has a web address (src/lib/site-graph.ts).
  personSchema(publications),
];
---

<BaseLayout
  title={`Press | ${site.name}`}
  description="Where my work has been published: magazine features and interviews, with the tear sheets."
  {schemas}
  {siteSettings}
  ogCard={{ kicker: 'Press' }}
>
  <section class="bg-background" aria-labelledby="press-heading">
    <div class="mx-auto max-w-content px-m py-section-md">
      <header class="press-head">
        <h1 id="press-heading" class="font-display text-h1 leading-headline-tight">
          Press
        </h1>
        <p class="portfolio-label">
          {publications.length} {publications.length === 1 ? 'feature' : 'features'}, newest first
        </p>
      </header>
      {placeholder && (
        <p class="portfolio-label mt-4">
          Placeholder publications, shown until the first one is added.
        </p>
      )}

      {years.map((group) => {
        const yearId = `press-${group.year ?? 'undated'}`;
        return (
          <section class="press-year" aria-labelledby={yearId}>
            <h2 id={yearId} class="press-year__label font-display">
              {group.year ?? 'Undated'}
            </h2>
            <ul class="press-list list-none">
              {group.items.map((pub) => (
                <li class="press-entry">
                  <div class="press-entry__sheet">
                    <FocusImage
                      photo={pub.tearSheet}
                      width={700}
                      crop={4 / 5}
                      sizes="(min-width: 64rem) 18rem, 40vw"
                    />
                  </div>
                  <div class="press-entry__text">
                    <p class="portfolio-label">
                      {[pub.issue, formatMonthYear(pub.date)].filter(Boolean).join(', ')}
                    </p>
                    <h3 class="press-entry__title font-display">{pub.magazine}</h3>
                    {pub.excerpt && (
                      <p class="press-entry__excerpt text-muted-foreground">{pub.excerpt}</p>
                    )}
                    {pub.url && (
                      <p class="mt-6">
                        <a
                          class="portfolio-label portfolio-link text-foreground"
                          href={pub.url}
                          rel="noopener"
                        >
                          Read the feature
                        </a>
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>

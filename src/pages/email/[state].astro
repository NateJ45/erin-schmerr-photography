---
// Safe to edit by hand (the words especially)
// =============================================================================
// /email/confirmed/, /email/unsubscribe/, /email/link-problem/
// The plain pages the newsletter's links land on (PORTS.md card 127).
// =============================================================================
//   confirmed     after "Yes, sign me up" in the confirmation email
//                 (/api/subscribe/confirm/ redirects here).
//   unsubscribe   the footer link of every issue. A button, not the link
//                 itself, does the unsubscribing: mail scanners open every
//                 link in an email, and must not take a reader off the list.
//   link-problem  a confirm link that is broken, expired or too old.
// Static and noindex; the unsubscribe button posts to /api/unsubscribe/.
//
// The site's own layout (2026-11-20, replaced the starter's plain prose page): a short letter on
// paper. "(Newsletter)" small over an ink rule, the title very large in Bodoni Moda with one word
// in its italic, the note in her voice, then the one action (the unsubscribe button is the page's
// one filled Dusk button) and the ways back as small tracked links. Styles in page-quiet.css.
// =============================================================================
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteSettings } from '@/lib/queries';
import { site } from '@/data/site';
import '@/styles/portfolio.css';
import '@/styles/page-quiet.css';

export function getStaticPaths() {
  return [
    { params: { state: 'confirmed' } },
    { params: { state: 'unsubscribe' } },
    { params: { state: 'link-problem' } },
  ];
}

const { state } = Astro.params as { state: 'confirmed' | 'unsubscribe' | 'link-problem' };
const siteSettings = await getSiteSettings();

// `title` is the page's name (the browser tab, plain words); `runs` is how the heading is set,
// with the italic word marked.
const COPY = {
  confirmed: {
    title: 'You are on the list',
    runs: [
      { text: 'You are on the ', italic: false },
      { text: 'list', italic: true },
    ],
    body: `Thank you for confirming. The next ${site.name} letter will come to your inbox. Every one has an unsubscribe link at the bottom, if you ever change your mind.`,
  },
  unsubscribe: {
    title: 'Unsubscribe from the newsletter',
    runs: [
      { text: 'Leaving the ', italic: false },
      { text: 'list', italic: true },
    ],
    body: 'Press the button and I will stop sending you the newsletter. You will not need to log in or give a reason.',
  },
  'link-problem': {
    title: 'That link did not work',
    runs: [
      { text: 'That link did not ', italic: false },
      { text: 'work', italic: true },
    ],
    body: 'The link may be incomplete, or more than a week old. Sign up again on the website and I will send you a fresh one.',
  },
} as const;
const copy = COPY[state];
---

<BaseLayout title={copy.title} description={copy.body} siteSettings={siteSettings} noindex>
  <section class="pq-letter mx-auto max-w-content px-m" aria-labelledby="email-state-heading">
    <p class="pq-letter__kicker portfolio-label">(Newsletter)</p>
    <h1 id="email-state-heading" class="pq-letter__title font-display">
      {copy.runs.map((r) => (r.italic ? <em>{r.text}</em> : r.text))}
    </h1>
    <div class="pq-letter__note">
      <p class="pq-letter__body" data-email-body>
        {copy.body}
      </p>
      {state === 'unsubscribe' && (
        <div class="pq-letter__action" data-unsubscribe>
          <button type="button" class="pq-button" data-unsubscribe-button>
            Unsubscribe me
          </button>
          <p class="pq-letter__status" role="status" aria-live="polite" data-unsubscribe-status />
        </div>
      )}
      <p class="pq-letter__ways">
        <a href="/stories/">See the stories</a>
        <a href="/">Back to the home page</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // The unsubscribe button: POST the token from this page's address to the Worker.
  const box = document.querySelector<HTMLElement>('[data-unsubscribe]');
  const button = box?.querySelector<HTMLButtonElement>('[data-unsubscribe-button]');
  const status = box?.querySelector<HTMLElement>('[data-unsubscribe-status]');
  const token = new URLSearchParams(location.search).get('t');
  if (box && button && status) {
    if (!token) {
      button.disabled = true;
      status.textContent =
        'This page needs the link from the bottom of a newsletter. Open that link again.';
    }
    button.addEventListener('click', async () => {
      button.disabled = true;
      status.textContent = 'Working on it…';
      try {
        const res = await fetch(`/api/unsubscribe/?t=${encodeURIComponent(token ?? '')}`, {
          method: 'POST',
          headers: { Accept: 'application/json' },
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (res.ok && body.ok) {
          button.hidden = true;
          status.textContent = 'Done. You will not get the newsletter any more.';
        } else {
          button.disabled = false;
          status.textContent = body.error ?? 'That did not work. Please try again in a minute.';
        }
      } catch {
        button.disabled = false;
        status.textContent = 'Could not reach the website. Check your connection and try again.';
      }
    });
  }
</script>

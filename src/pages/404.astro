---
// Safe to edit by hand
// =============================================================================
// 404, "Lost" (2026-11-20, replaced the starter's two-column page)
// =============================================================================
// A magazine spread for a missing page. "Lost" is set across the whole column
// in Bodoni Moda, cut out of the paper so one of her photographs shows through
// the letters (background-clip: text, never a blend mode). Under an ink rule:
// the real heading and a line in her voice, then the ways back set like a
// contents page (I. The stories, II. Book a session, III. The home page), and
// a small credit naming the photograph in the letters.
//
// The photo: the 404 document's own image (Studio, "Page not found"), else the
// first featured story's cover; with no real photo the letters are ink. The
// knockout word is decorative (aria-hidden, data-contrast-decorative) and prints
// as plain ink. With motion allowed it racks from soft to sharp once on load.
//
// Words: the 404 document's headline and line when someone has written their
// own; the starter's seeded words ("That page wandered off.") count as none.
// The ways back are fixed routes, not the document's button fields, because
// they are this site's own pages. With site search on, a search field comes
// first (a plain GET form to /search/, so it works without JavaScript).
// =============================================================================
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNotFoundPage, getSiteSettings } from '@/lib/queries';
import { getFeaturedStories } from '@/lib/storyQueries';
import { urlFor } from '@/lib/sanity';
import { site } from '@/data/site';
import '@/styles/portfolio.css';
import '@/styles/page-quiet.css';

const [notFoundPage, siteSettings, featured] = await Promise.all([
  getNotFoundPage(),
  getSiteSettings(),
  getFeaturedStories(1),
]);

// The starter seeded these; they are not this site's words.
const SEEDED = /wandered off|it happens\. maybe a link is old/i;
const own = (v: string | null | undefined) => (v && !SEEDED.test(v) ? v : null);

const seoTitle = own(notFoundPage?.seoTitle) ?? 'Page not found';
const seoDescription =
  own(notFoundPage?.seoDescription) ??
  'This page is lost. The stories and portraits are all still here.';
const headline = own(notFoundPage?.headline) ?? 'This page has slipped out of frame.';
const body =
  own(notFoundPage?.body) ??
  'The link may be old, or a letter went astray on the way here. Every portrait is still where I left it.';

// The photograph in the letters, and what to credit it to.
const story = featured.find((s) => s.cover?.asset);
const photo = notFoundPage?.heroImage?.asset ? notFoundPage.heroImage : story?.cover;
const fill = photo?.asset ? urlFor(photo).width(2000).fit('max').auto('format').url() : null;
const hotspot = (photo as { hotspot?: { x?: number; y?: number } } | undefined)?.hotspot;
const fillPos =
  hotspot && typeof hotspot.x === 'number' && typeof hotspot.y === 'number'
    ? `${(hotspot.x * 100).toFixed(1)}% ${(hotspot.y * 100).toFixed(1)}%`
    : '50% 40%';
const knockStyle = fill ? `--nf-fill: url("${fill}"); --nf-pos: ${fillPos}` : undefined;
const credit = notFoundPage?.heroImage?.asset
  ? null
  : story
    ? { title: story.title, href: `/stories/${story.slug}/` }
    : null;

const ways = [
  { n: 'I.', label: 'The stories', note: 'Every sitting, as a short film', href: '/stories/' },
  { n: 'II.', label: 'Book a session', note: 'Tell me what you have in mind', href: '/contact/' },
  { n: 'III.', label: 'The home page', note: 'Start again from the cover', href: '/' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  siteSettings={siteSettings}
  noindex
  flow="full"
>
  <section class="nf" aria-labelledby="not-found-heading" data-page-not-found>
    <div class="nf__frame mx-auto max-w-content px-m">
      <p class="nf__masthead portfolio-label" aria-hidden="true">
        <span>No. 404</span>
        <span>Not found</span>
      </p>
      <p
        class:list={['nf__knock font-display', fill && 'nf__knock--photo']}
        style={knockStyle}
        aria-hidden="true"
        data-contrast-decorative
      >
        Lost
      </p>
    </div>

    <div class="nf__body mx-auto max-w-content px-m">
      <div class="nf__words">
        <h1 id="not-found-heading" class="nf__title font-display">
          {headline}
        </h1>
        <p class="nf__line">{body}</p>
        {credit && (
          <p class="nf__credit portfolio-label">
            In the letters: <a href={credit.href}>{credit.title}</a>
          </p>
        )}
      </div>

      <nav class="nf__ways" aria-labelledby="not-found-ways">
        <h2 id="not-found-ways" class="portfolio-label">
          Where to go from here
        </h2>

        {site.search.enabled && (
          <form class="nf__search" role="search" action="/search/" method="get">
            <label for="not-found-search" class="sr-only">
              Search the site
            </label>
            <input
              id="not-found-search"
              type="search"
              name="q"
              autocomplete="off"
              enterkeyhint="search"
              placeholder={site.search.placeholder}
            />
            <button type="submit" class="bq-button">
              Search
            </button>
          </form>
        )}

        <ol class="nf__list list-none">
          {ways.map((w) => (
            <li>
              <a href={w.href} class="nf__way">
                <span class="nf__num font-display" aria-hidden="true">
                  {w.n}
                </span>
                <span class="nf__label font-display">{w.label}</span>
                <span class="nf__note">{w.note}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </section>
</BaseLayout>

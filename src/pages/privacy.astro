---
// Safe to edit by hand
// Privacy policy page. Fetches the privacyPage singleton from Sanity for the
// body and lastUpdated date. When the doc doesn't exist yet (or Sanity isn't
// reachable), a plain-voice fallback policy is rendered so the page is always
// live and accurate.
//
// A page builder since card 190 (ported from FBC Auburn): when the document's Page layout has
// sections, they render through SectionRenderer, and the policy is the "Privacy policy text"
// block (src/components/sections/PrivacyPolicy.astro, which also holds the built-in fallback
// copy and the analytics-aware wording). With an EMPTY Page layout the page draws its own
// masthead, then that same block fed by the document's own body and date.
//
// The site's own layout (2026-11-20, replaced the starter Hero): a masthead on paper, "(Privacy)"
// small over the title very large in Bodoni Moda with its last word in italic (or the words the
// editor wrapped in underscores), and one line under it; then the policy as a magazine's small
// print, a contents rail beside numbered, ruled sections (PrivacyPolicy.astro, page-quiet.css).
// The policy's words are unchanged in meaning.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import PrivacyPolicy from '@/components/sections/PrivacyPolicy.astro';
import { getPrivacyPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { cinemaRuns } from '@/lib/portfolio';
import { site } from '@/data/site';
import { firstReal, pageDescription, pageTitle } from '@/lib/page-meta';
import '@/styles/portfolio.css';
import '@/styles/page-quiet.css';

const [page, siteSettings] = await Promise.all([getPrivacyPage(), getSiteSettings()]);

// Real words only (src/lib/page-meta.ts): a seeded placeholder in the Studio is skipped.
const title = pageTitle(page?.seoTitle, 'Privacy policy');
const description = pageDescription(
  page?.seoDescription,
  'How I handle what you send me through this site, and what the site measures.',
);

const heroHeadline = firstReal(page?.heroHeadline) ?? 'Privacy policy';
const heroSubhead =
  firstReal(page?.heroSubhead) ??
  'What happens to what you send me, and what this site measures, in plain words.';
const titleRuns = cinemaRuns(heroHeadline);

// The Page layout, when the editor has built one. Empty means the classic layout below.
const sections = page?.pageBuilder?.length ? page.pageBuilder : null;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Privacy Policy', url: `${site.url}/privacy/` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  {sections ? (
    <SectionRenderer {sections} idPrefix="privacy" />
  ) : (
    <>
      <header class="pq-mast mx-auto max-w-content px-m" aria-labelledby="privacy-hero-heading">
        <p class="pq-mast__kicker portfolio-label">(Privacy)</p>
        <h1 id="privacy-hero-heading" class="pq-mast__title font-display">
          {titleRuns.map((r) => (r.italic ? <em>{r.text}</em> : r.text))}
        </h1>
        {heroSubhead && <p class="pq-mast__line">{heroSubhead}</p>}
      </header>

      <PrivacyPolicy lastUpdated={page?.lastUpdated} body={page?.body} />
    </>
  )}
</BaseLayout>

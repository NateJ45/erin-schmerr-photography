---
// Safe to edit by hand for copy + structure changes.
// Home page — section-driven via pageBuilder.
// Edit sections and order in Sanity Studio under the Home Page document.
// When pageBuilder is empty (no Sanity project or unseeded), DEFAULT_HOME_SECTIONS
// renders so the page is never blank.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getHomePage, getSiteSettings } from '@/lib/queries';
import { getPublications } from '@/lib/pressQueries'; // scaffold: press
import { personSchema, type PressFeature } from '@/lib/site-graph';
import { pageDescription, pageTitle } from '@/lib/page-meta';
import { site } from '@/data/site';
import { DEFAULT_HOME_SECTIONS } from '@/data/defaultSections';

const [page, siteSettings] = await Promise.all([getHomePage(), getSiteSettings()]);

// The Studio's SEO fields win when they hold real words; otherwise the site's own
// description (src/data/site.ts), never a placeholder (src/lib/page-meta.ts).
const title = pageTitle(page?.seoTitle, site.name);
const description = pageDescription(page?.seoDescription, site.description);

// The photographer, linked to the business by @id, with her press features.
const press: PressFeature[] = [];
press.push(...(await getPublications())); // scaffold: press
const schemas = [personSchema(press)];

const sections = page?.pageBuilder?.length ? page.pageBuilder : DEFAULT_HOME_SECTIONS;
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  ogCard={{ home: true }}
  flow="full"
>
  <SectionRenderer {sections} idPrefix="home" />
</BaseLayout>

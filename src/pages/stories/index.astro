---
// scaffold-file: stories
// Safe to edit by hand
// /stories/: every story as a magazine's contents page, a List / Grid toggle
// (StoriesContents.astro, 2026-11-20; replaced the film reel of 2026-11-18),
// in sections by decade, each in the Studio's drag order (Portfolio >
// Stories). With no Sanity data it shows the placeholder stories from
// src/lib/storyQueries.ts, and says so.
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoriesContents from '@/components/magazine/StoriesContents.astro';
import { getSiteSettings } from '@/lib/queries';
import { getStories } from '@/lib/storyQueries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

const [stories, siteSettings] = await Promise.all([getStories(), getSiteSettings()]);
const placeholder = stories.every((s) => s.isPlaceholder);

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Stories', url: `${site.url}/stories/` },
  ]),
];
---

<BaseLayout
  title={`Stories | ${site.name}`}
  description="My portrait and editorial stories, each one told as a sequence of photographs: vintage looks, old films and books, Cincinnati places."
  {schemas}
  {siteSettings}
  ogCard={{ kicker: 'Stories' }}
>
  <StoriesContents {stories} {placeholder} />
</BaseLayout>

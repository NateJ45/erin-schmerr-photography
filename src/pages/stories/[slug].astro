---
// scaffold-file: stories
// Safe to edit by hand
// /stories/<slug>/: one story, set like a magazine feature (DESIGN.md "Story
// page", 2026-11-20; replaced the slideshow film of 2026-11-18).
//
// 1. THE SPREAD. The cover full bleed (a portrait shows whole over a blurred,
//    darkened copy of itself on a wide screen, so her Instagram-sized copies
//    are never blown up), the publication set over its top as a masthead
//    (storyMasthead(): the magazine, else the house name "Tate"), sized from its
//    letter count so it holds one line, and the story's title across the
//    cover's bottom edge: ink on paper below, paper on the photograph above
//    (two copies, the paper one aria-hidden and clipped; never a blend mode).
//    The cover shares transition:name `story-cover-<slug>` with the /stories/
//    thumbnail, so the thumbnail grows into it (Astro's router; at rest under
//    reduced motion, where the router skips the animation).
// 2. THE STANDFIRST AND CREDITS. The story's line large in the display italic
//    beside a credits box ruled like a magazine masthead: photography, the
//    cast and crew from the credits, then publication, issue and date, where
//    the idea started and the place.
// 3. THE FEATURE. The rest of the photos (storyFrames(), the cover never
//    twice) laid out by editorialRuns(): a pair, a single on paper, a full
//    bleed, repeating, every plate numbered and captioned (her caption and the
//    camera line).
// 4. THE TURN. A short invitation with the site's outlined button, then the
//    previous and next stories set large with their covers (the first story
//    follows the last). Their covers carry the same transition names, so the
//    next story's cover grows into its spread too.
//
// getStaticPaths reads every story once and hands each page its own story and
// its neighbours as props, so a page never re-queries. With no Sanity data it
// builds the placeholder stories (src/lib/storyQueries.ts).
import BaseLayout from '@/layouts/BaseLayout.astro';
import FocusImage from '@/components/portfolio/FocusImage.astro';
import { getSiteSettings } from '@/lib/queries';
import { getStories, type Story } from '@/lib/storyQueries';
import {
  collaboratorHref,
  formatExif,
  formatMonthYear,
  photoRatio,
  storyFrames,
  type PortfolioPhoto,
} from '@/lib/portfolio';
import { editorialRuns, mastheadSize, plateNo, storyMasthead } from '@/lib/magazine';
import { breadcrumbSchema } from '@/lib/schemas';
import { storySchema } from '@/lib/portfolio-schemas';
import { site } from '@/data/site';
import { pageDescription, pageTitle } from '@/lib/page-meta';
import '@/styles/magazine.css';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story, i) => {
    const prev = stories[i - 1] ?? null;
    // The first story follows the last, so every story ends on a next one.
    const next = stories[i + 1] ?? (stories.length > 1 ? stories[0] : null);
    const brief = (s: Story) => ({ title: s.title, slug: s.slug, cover: s.cover ?? null });
    return {
      params: { slug: story.slug },
      props: {
        story,
        number: i + 1,
        prev: prev && prev.slug !== next?.slug ? brief(prev) : null,
        next: next ? brief(next) : null,
      },
    };
  });
}

interface Neighbour {
  title: string;
  slug: string;
  cover: PortfolioPhoto | null;
}

const { story, number, prev, next } = Astro.props as {
  story: Story;
  number: number;
  prev: Neighbour | null;
  next: Neighbour | null;
};

const siteSettings = await getSiteSettings();

// The house name: the first word of the site's name ("Tate"), as the footer sets it.
const house = site.name.split(/\s+/)[0] ?? site.name;
const pub = story.publication;
const masthead = storyMasthead(story, house);
const issueLine = pub?.magazine
  ? [pub.issue, formatMonthYear(pub.date)].filter(Boolean).join(', ')
  : [story.location, formatMonthYear(story.date)].filter(Boolean).join(', ');
const when = formatMonthYear(story.date);

const frames = storyFrames(story.cover, story.photos);
const cover = frames[0] ?? null;
const runs = editorialRuns(frames.slice(1), 2);
const lqip = (p: PortfolioPhoto | null | undefined) => p?.asset?.metadata?.lqip ?? '';
const bleedStyle = (p: PortfolioPhoto | null | undefined) =>
  [`--r: ${photoRatio(p).toFixed(4)}`, lqip(p) ? `--bleed-lqip: url("${lqip(p)}")` : '']
    .filter(Boolean)
    .join('; ');
const caption = (p: PortfolioPhoto) => (p.caption ?? '').trim();

// The credits box: photography first, then the cast and crew, then where it ran.
const credits = (story.credits ?? []).filter((c) => c?.name);
const facts = [
  { label: 'Publication', value: pub?.magazine ?? '', href: pub?.url ?? '' },
  { label: 'Issue', value: pub?.issue ?? '', href: '' },
  { label: 'Published', value: formatMonthYear(pub?.date), href: '' },
  { label: 'Started from', value: story.startedFrom ?? '', href: '' },
  { label: 'Place', value: story.location ?? '', href: '' },
  { label: 'Photographed', value: when, href: '' },
].filter((row) => row.value);

// Real words only (src/lib/page-meta.ts): a placeholder dek falls through to the plain line.
const title = pageTitle(story.seoTitle, `${story.title} | ${site.name}`);
const description = pageDescription(
  story.seoDescription,
  story.dek,
  `${story.title}, a portrait story by Erin Schmerr, ${site.name}.`,
);

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Stories', url: `${site.url}/stories/` },
    { name: story.title, url: `${site.url}/stories/${story.slug}/` },
  ]),
  storySchema(story),
];
// The share picture: the story's own SEO image, else its cover (a real file only).
const shareImage = story.seoImage ?? (story.cover?.asset ? story.cover : undefined);
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={shareImage}
  noindex={story.hideFromSearch === true}
  ogType="article"
  ogCard={{ kicker: 'Stories' }}
>
  <article class="mag-story" aria-labelledby="story-title">
    <header class="mag-spread">
      <div
        class="mag-bleed mag-spread__cover"
        style={bleedStyle(cover)}
        transition:name={`story-cover-${story.slug}`}
        transition:animate="initial"
      >
        <FocusImage
          photo={cover}
          width={1800}
          sizes="(min-aspect-ratio: 1/1) 70vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="mag-bleed__pic"
          pull={false}
        />
        <div class="mag-spread__top">
          <p class="mag-spread__kicker">
            <a href="/stories/">Stories</a>, No. {plateNo(number)}
            {story.isPlaceholder && <span>, placeholder</span>}
          </p>
          <p class="mag-spread__masthead" style={`--mast: ${mastheadSize(masthead)}`}>
            {masthead}
          </p>
          {issueLine && <p class="mag-spread__issue">{issueLine}</p>}
        </div>
      </div>
      <div class="mag-spread__title">
        <h1 id="story-title" class="mag-spread__h1">
          {story.title}
        </h1>
        <span
          class="mag-spread__h1 mag-spread__h1--over"
          aria-hidden="true"
          data-contrast-decorative
        >
          {story.title}
        </span>
      </div>
    </header>

    <section class="mag-standfirst" aria-labelledby="story-credits">
      <div class="mag-standfirst__text">
        {story.dek && <p class="mag-standfirst__dek">{story.dek}</p>}
        <p class="mag-standfirst__count">
          {frames.length}
          {frames.length === 1 ? 'photograph' : 'photographs'}
          {when && <span>, {when}</span>}
        </p>
      </div>
      <aside class="mag-box">
        <h2 id="story-credits" class="mag-box__head">
          Credits
        </h2>
        <dl class="mag-box__list">
          <div>
            <dt>Photography</dt>
            <dd>Erin Schmerr</dd>
          </div>
          {credits.map((c) => {
            const href = collaboratorHref(c);
            return (
              <div>
                <dt>{c.role || 'Credit'}</dt>
                <dd>
                  {href ? (
                    <a href={href} rel="noopener">
                      {c.name}
                    </a>
                  ) : (
                    c.name
                  )}
                </dd>
              </div>
            );
          })}
        </dl>
        {facts.length > 0 && (
          <dl class="mag-box__list mag-box__list--facts">
            {facts.map((row) => (
              <div>
                <dt>{row.label}</dt>
                <dd>
                  {row.href ? (
                    <a href={row.href} rel="noopener">
                      {row.value}
                    </a>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </aside>
    </section>

    {runs.length > 0 && (
      <section class="mag-feature" aria-label={`${story.title}, the photographs`}>
        {runs.map((run) =>
          run.kind === 'bleed' ? (
            <figure class="mag-run mag-run--bleed">
              <div class="mag-bleed" style={bleedStyle(run.plates[0].photo)}>
                <FocusImage
                  photo={run.plates[0].photo}
                  width={1800}
                  sizes="(min-aspect-ratio: 1/1) 70vw, 100vw"
                  class="mag-bleed__pic"
                />
              </div>
              <figcaption class="mag-cap">
                <span class="mag-cap__no">{plateNo(run.plates[0].no)}</span>
                <span class="mag-cap__text">
                  {caption(run.plates[0].photo)}
                  {formatExif(run.plates[0].photo.exif) && (
                    <span class="mag-cap__exif">{formatExif(run.plates[0].photo.exif)}</span>
                  )}
                </span>
              </figcaption>
            </figure>
          ) : (
            <div
              class:list={['mag-run', `mag-run--${run.kind}`, run.side && `mag-run--${run.side}`]}
            >
              {run.plates.map((plate) => (
                <figure class="mag-plate">
                  <FocusImage
                    photo={plate.photo}
                    width={1200}
                    sizes="(min-width: 48rem) 45vw, 100vw"
                  />
                  <figcaption class="mag-cap">
                    <span class="mag-cap__no">{plateNo(plate.no)}</span>
                    <span class="mag-cap__text">
                      {caption(plate.photo)}
                      {formatExif(plate.photo.exif) && (
                        <span class="mag-cap__exif">{formatExif(plate.photo.exif)}</span>
                      )}
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ),
        )}
      </section>
    )}

    <section class="mag-ask" aria-labelledby="story-ask">
      <span class="mag-ask__end" aria-hidden="true"></span>
      <h2 id="story-ask" class="mag-ask__line">
        Want a sitting like this one?
      </h2>
      <p class="mag-ask__text">
        Bring me a decade, a character or a book you love, and I will plan the clothes, the place
        and the light with you.
      </p>
      <p>
        <a class="bq-button" href="/contact/">
          Plan your sitting
        </a>
      </p>
    </section>

    {(prev || next) && (
      <nav class="mag-turn" aria-label="More stories">
        {prev && (
          <a href={`/stories/${prev.slug}/`} class="mag-turn__link mag-turn__link--prev">
            <span
              class="mag-turn__cover"
              transition:name={`story-cover-${prev.slug}`}
              transition:animate="initial"
            >
              <FocusImage
                photo={prev.cover}
                width={700}
                crop={4 / 5}
                sizes="(min-width: 48rem) 16vw, 30vw"
                alt=""
              />
            </span>
            <span class="mag-turn__text">
              <span class="mag-turn__label">Previous story</span>
              <span class="mag-turn__title">{prev.title}</span>
            </span>
          </a>
        )}
        {next && (
          <a href={`/stories/${next.slug}/`} class="mag-turn__link mag-turn__link--next">
            <span
              class="mag-turn__cover"
              transition:name={`story-cover-${next.slug}`}
              transition:animate="initial"
            >
              <FocusImage
                photo={next.cover}
                width={900}
                crop={4 / 5}
                sizes="(min-width: 48rem) 22vw, 40vw"
                alt=""
              />
            </span>
            <span class="mag-turn__text">
              <span class="mag-turn__label">Next story</span>
              <span class="mag-turn__title">{next.title}</span>
            </span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

---
// scaffold-file: stories
// Safe to edit by hand
// /stories/<slug>/: one story, set like a magazine feature. The opener puts the
// cover beside the title, its short line, where and when, the credits and the
// "Published in" note (a landscape cover runs full bleed above them instead).
// Then the photo sequence in an editorial rhythm (storySequence: landscapes
// wide, portraits paired as a spread, a lone portrait set off to one side),
// each with its caption and the camera line read from the file's EXIF, and a
// closing "Next story" with its cover (the first story follows the last), plus
// a quiet link back to the previous story. Before it, a case-study close:
// "How this was made" (where the idea came from, the place, the cast, derived
// from the credits by storyCast) beside "Want a session like this?" and a
// link to the contact page.
//
// getStaticPaths reads every story once and hands each page its own story and
// its neighbours as props, so a page never re-queries. With no Sanity data it
// builds the placeholder stories (src/lib/storyQueries.ts).
import BaseLayout from '@/layouts/BaseLayout.astro';
import FocusImage from '@/components/portfolio/FocusImage.astro';
import CreditBlock from '@/components/portfolio/CreditBlock.astro';
import CtaLink from '@/components/CtaLink.astro';
import { getSiteSettings } from '@/lib/queries';
import { getStories, type Story } from '@/lib/storyQueries';
import { formatExif, formatMonthYear, photoRatio, storyCast, storySequence } from '@/lib/portfolio';
import { breadcrumbSchema } from '@/lib/schemas';
import { storySchema } from '@/lib/portfolio-schemas';
import { site } from '@/data/site';
import '@/styles/portfolio.css';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story, i) => {
    const prev = stories[i - 1] ?? null;
    // The first story follows the last, so every story ends on a next one.
    const next = stories[i + 1] ?? (stories.length > 1 ? stories[0] : null);
    return {
      params: { slug: story.slug },
      props: {
        story,
        prev: prev ? { title: prev.title, slug: prev.slug } : null,
        next: next
          ? { title: next.title, slug: next.slug, dek: next.dek ?? null, cover: next.cover ?? null }
          : null,
      },
    };
  });
}

interface Neighbour {
  title: string;
  slug: string;
  dek?: string | null;
  cover?: Story['cover'];
}

const { story, prev, next } = Astro.props as {
  story: Story;
  prev: Neighbour | null;
  next: Neighbour | null;
};

const siteSettings = await getSiteSettings();

const when = formatMonthYear(story.date);
const meta = [story.location, when].filter(Boolean).join(', ');
const photos = story.photos ?? [];
const sequence = storySequence(photos);
// A landscape cover runs full bleed above the opener; a portrait one sits
// beside the title as the left page of a spread.
const coverLandscape = photoRatio(story.cover) >= 1;
const hasCredits = (story.credits ?? []).some((c) => c?.name);
// "How this was made": only the facts this story has.
const cast = storyCast(story.credits, story.location);
const made = [
  { label: 'Started from', value: story.startedFrom ?? '' },
  { label: 'Place', value: story.location ?? '' },
  { label: 'The cast', value: cast.join(', ') },
].filter((row) => row.value);
const title = story.seoTitle || `${story.title} | ${site.name}`;
const description = story.seoDescription || story.dek || `${story.title}, a story by ${site.name}.`;
// scaffold: press
const pub = story.publication;
const pubLine = pub?.magazine ? [pub.magazine, pub.issue].filter(Boolean).join(', ') : '';
// scaffold:end

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Stories', url: `${site.url}/stories/` },
    { name: story.title, url: `${site.url}/stories/${story.slug}/` },
  ]),
  storySchema(story),
];
// The share picture: the story's own SEO image, else its cover (a real file only).
const shareImage = story.seoImage ?? (story.cover?.asset ? story.cover : undefined);
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={shareImage}
  noindex={story.hideFromSearch === true}
  ogType="article"
  ogCard={{ kicker: 'Stories' }}
>
  <article class="story bg-background" aria-labelledby="story-title">
    {story.cover && coverLandscape && (
      <div class="story-cover--wide">
        <FocusImage
          photo={story.cover}
          width={2400}
          crop={16 / 9}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          pull={false}
        />
      </div>
    )}

    <header
      class:list={[
        'story-opener mx-auto max-w-content px-m',
        story.cover && !coverLandscape ? 'story-opener--spread' : 'story-opener--plain',
      ]}
    >
      {story.cover && !coverLandscape && (
        <div class="story-opener__cover">
          <FocusImage
            photo={story.cover}
            width={1200}
            sizes="(min-width: 64rem) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
            pull={false}
          />
        </div>
      )}
      <div class="story-opener__text">
        <p class="portfolio-label">
          <a class="portfolio-link" href="/stories/">
            Stories
          </a>
          {story.isPlaceholder && <span> · Placeholder</span>}
        </p>
        <h1 id="story-title" class="story-title font-display">
          {story.title}
        </h1>
        {story.dek && <p class="story-dek text-muted-foreground">{story.dek}</p>}
        {meta && <p class="portfolio-label mt-6">{meta}</p>}
        {(hasCredits || pubLine) && (
          <div class="story-opener__credits">
            <CreditBlock credits={story.credits} />
            {/* scaffold: press */}
            {pubLine && (
              <p class="portfolio-label mt-6">
                Published in{' '}
                {pub?.url ? (
                  <a class="portfolio-link text-foreground" href={pub.url} rel="noopener">
                    {pubLine}
                  </a>
                ) : (
                  <span class="text-foreground">{pubLine}</span>
                )}
              </p>
            )}
            {/* scaffold:end */}
          </div>
        )}
      </div>
    </header>

    {sequence.length > 0 && (
      <ol class="story-sequence mx-auto max-w-content list-none px-m">
        {sequence.map((row) => (
          <li
            class:list={[
              'story-row',
              `story-row--${row.kind}`,
              row.kind === 'single' && `story-row--${row.align}`,
            ]}
          >
            {row.photos.map((photo) => {
              const exif = formatExif(photo.exif);
              return (
                <figure>
                  <FocusImage
                    photo={photo}
                    width={row.kind === 'wide' ? 1800 : 1200}
                    crop={row.kind === 'pair' ? 4 / 5 : undefined}
                    sizes={
                      row.kind === 'wide'
                        ? '(min-width: 82.5rem) 80rem, 100vw'
                        : '(min-width: 48rem) 50vw, 100vw'
                    }
                  />
                  {(photo.caption || exif) && (
                    <figcaption class="mt-2 flex flex-wrap justify-between gap-x-6 gap-y-1">
                      {photo.caption && <span class="portfolio-label">{photo.caption}</span>}
                      {exif && <span class="portfolio-label">{exif}</span>}
                    </figcaption>
                  )}
                </figure>
              );
            })}
          </li>
        ))}
      </ol>
    )}

    <section
      class="story-made split mx-auto max-w-content px-m"
      aria-labelledby="story-made-heading"
    >
      <div>
        <h2 id="story-made-heading" class="portfolio-label mb-4">
          How this was made
        </h2>
        {made.length > 0 && (
          <dl class="credit-block">
            {made.map((row) => (
              <div>
                <dt class="portfolio-label">{row.label}</dt>
                <dd class="text-foreground">{row.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
      <div>
        <p class="story-made__ask font-display">Want a session like this?</p>
        <p class="mt-3 text-muted-foreground">
          Bring me a decade, a character or a story, and I will plan the rest with you.
        </p>
        <p class="mt-6">
          <CtaLink cta={{ label: 'Get in touch', href: '/contact/' }} variant="secondary" />
        </p>
      </div>
    </section>

    <nav class="story-next mx-auto max-w-content px-m" aria-label="More stories">
      {next && (
        <a href={`/stories/${next.slug}/`} class="story-next__link">
          <span class="story-next__text">
            <span class="portfolio-label block">Next story</span>
            <span class="story-next__title font-display">{next.title}</span>
            {next.dek && <span class="mt-3 block text-muted-foreground">{next.dek}</span>}
          </span>
          {next.cover && (
            <span class="story-next__cover">
              <FocusImage
                photo={next.cover}
                width={900}
                crop={4 / 5}
                sizes="(min-width: 48rem) 30vw, 60vw"
                alt=""
              />
            </span>
          )}
        </a>
      )}
      {prev && (
        <p class="mt-10">
          <a href={`/stories/${prev.slug}/`} class="portfolio-label portfolio-link">
            Previous story: {prev.title}
          </a>
        </p>
      )}
    </nav>
  </article>
</BaseLayout>

---
// scaffold-file: stories
// Safe to edit by hand
// /stories/<slug>/: one story, played as a slideshow film (picked 2026-11-18,
// design-directions "direction I"; DESIGN.md "Story page"). The cover and then
// the photos (storyFrames) are full-screen frames: a portrait shown whole over
// its own blurred LQIP on a wide screen, the caption as a subtitle on a paper
// chip, the title on a chip at the top. src/scripts/story-film.ts stacks them in
// one screen and plays them (4.8s holds, a slow push-in, segmented progress,
// Pause/Play, Previous/Next, arrow keys, Space, swipe) and burns each print into
// the next with src/scripts/film-burn.ts (WebGL, where CORS allows; else a
// crossfade with a focus pull). The cast, the story's line, place and date and
// "Published in" are the end credits, the film's last frame. Without
// JavaScript all of it is a vertical run of full-bleed frames, first frame
// first. After the film: "How this was made" (where the idea came from, the
// place, the cast from storyCast) beside "Want a session like this?", then
// "Next story" with its cover (the first story follows the last) and a quiet
// link back to the previous story.
//
// getStaticPaths reads every story once and hands each page its own story and
// its neighbours as props, so a page never re-queries. With no Sanity data it
// builds the placeholder stories (src/lib/storyQueries.ts).
import BaseLayout from '@/layouts/BaseLayout.astro';
import FocusImage from '@/components/portfolio/FocusImage.astro';
import CreditBlock from '@/components/portfolio/CreditBlock.astro';
import CtaLink from '@/components/CtaLink.astro';
import { getSiteSettings } from '@/lib/queries';
import { getStories, type Story } from '@/lib/storyQueries';
import { formatExif, formatMonthYear, photoRatio, storyCast, storyFrames } from '@/lib/portfolio';
import { urlFor } from '@/lib/sanity';
import { breadcrumbSchema } from '@/lib/schemas';
import { storySchema } from '@/lib/portfolio-schemas';
import { site } from '@/data/site';
import { pageDescription, pageTitle } from '@/lib/page-meta';
import '@/styles/portfolio.css';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story, i) => {
    const prev = stories[i - 1] ?? null;
    // The first story follows the last, so every story ends on a next one.
    const next = stories[i + 1] ?? (stories.length > 1 ? stories[0] : null);
    return {
      params: { slug: story.slug },
      props: {
        story,
        prev: prev ? { title: prev.title, slug: prev.slug } : null,
        next: next
          ? { title: next.title, slug: next.slug, dek: next.dek ?? null, cover: next.cover ?? null }
          : null,
      },
    };
  });
}

interface Neighbour {
  title: string;
  slug: string;
  dek?: string | null;
  cover?: Story['cover'];
}

const { story, prev, next } = Astro.props as {
  story: Story;
  prev: Neighbour | null;
  next: Neighbour | null;
};

const siteSettings = await getSiteSettings();

const when = formatMonthYear(story.date);
const meta = [story.location, when].filter(Boolean).join(', ');
// The burn reads each photo through WebGL at this width. It is not a srcset
// step (src/lib/imageLadder.ts), so its CORS request never meets a cached
// non-CORS copy of the same file.
const BURN_WIDTH = 1280;
const frames = storyFrames(story.cover, story.photos).map((photo, i) => {
  const ratio = photoRatio(photo);
  return {
    photo,
    first: i === 0,
    portrait: ratio < 1,
    ratio,
    // The subtitle: her caption, else the photo's own description.
    caption: (photo.caption ?? '').trim() || (photo.alt ?? '').trim(),
    exif: formatExif(photo.exif),
    lqip: photo.asset?.metadata?.lqip ?? '',
    burnSrc: photo.asset ? urlFor(photo).width(BURN_WIDTH).quality(70).auto('format').url() : '',
    x: photo.hotspot?.x ?? 0.5,
    y: photo.hotspot?.y ?? 0.5,
  };
});
const hasCredits = (story.credits ?? []).some((c) => c?.name);
// "How this was made": only the facts this story has.
const cast = storyCast(story.credits, story.location);
const made = [
  { label: 'Started from', value: story.startedFrom ?? '' },
  { label: 'Place', value: story.location ?? '' },
  { label: 'The cast', value: cast.join(', ') },
].filter((row) => row.value);
// Real words only (src/lib/page-meta.ts): a placeholder dek falls through to the plain line.
const title = pageTitle(story.seoTitle, `${story.title} | ${site.name}`);
const description = pageDescription(
  story.seoDescription,
  story.dek,
  `${story.title}, a portrait story by Erin Schmerr, ${site.name}.`,
);
// scaffold: press
const pub = story.publication;
const pubLine = pub?.magazine ? [pub.magazine, pub.issue].filter(Boolean).join(', ') : '';
// scaffold:end

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Stories', url: `${site.url}/stories/` },
    { name: story.title, url: `${site.url}/stories/${story.slug}/` },
  ]),
  storySchema(story),
];
// The share picture: the story's own SEO image, else its cover (a real file only).
const shareImage = story.seoImage ?? (story.cover?.asset ? story.cover : undefined);
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={shareImage}
  noindex={story.hideFromSearch === true}
  ogType="article"
  ogCard={{ kicker: 'Stories' }}
>
  <article class="story bg-background" aria-labelledby="story-title">
    <section
      class="film"
      data-film
      aria-roledescription="film"
      aria-label={`${story.title}, frame by frame`}
    >
      <div class="film__title film__chip">
        <p class="film__kicker">
          <a class="portfolio-link" href="/stories/">
            Stories
          </a>
          {story.isPlaceholder && <span> · Placeholder</span>}
        </p>
        <h1 id="story-title" class="film__h1 font-display">
          {story.title}
        </h1>
        {meta && <p class="film__meta">{meta}</p>}
      </div>

      <ol class="film__frames">
        {frames.map((f, i) => (
          <li
            class:list={[
              'film__frame',
              f.portrait ? 'film__frame--portrait' : 'film__frame--landscape',
            ]}
            data-film-frame
            data-caption={f.caption || undefined}
            data-burn-src={f.burnSrc || undefined}
            data-lqip={f.lqip || undefined}
            data-ratio={f.ratio.toFixed(4)}
            data-x={f.x.toFixed(3)}
            data-y={f.y.toFixed(3)}
            data-first-viewport-exempt={i === 0 ? undefined : ''}
            aria-label={`Frame ${i + 1} of ${frames.length + 1}`}
          >
            <FocusImage
              photo={f.photo}
              width={f.portrait ? 1600 : 2400}
              sizes={f.portrait ? '(min-aspect-ratio: 1/1) 85vh, 100vw' : '100vw'}
              loading={f.first ? 'eager' : 'lazy'}
              fetchpriority={f.first ? 'high' : 'low'}
              class="film__pic"
              pull={false}
            />
            {(f.caption || f.exif) && (
              <p class="film__sub film__chip">
                {f.caption}
                {f.exif && <span class="film__exif">{f.exif}</span>}
              </p>
            )}
          </li>
        ))}
        <li
          class="film__frame film__frame--end"
          data-film-frame
          data-end
          data-first-viewport-exempt
          aria-label={`Frame ${frames.length + 1} of ${frames.length + 1}, end credits`}
        >
          <div class="film__end">
            <p class="film__end-title font-display">{hasCredits ? 'Starring' : 'The end'}</p>
            {hasCredits && <CreditBlock credits={story.credits} heading="The cast and crew" />}
            {story.dek && <p class="film__end-dek text-muted-foreground">{story.dek}</p>}
            {meta && <p class="portfolio-label mt-4">{meta}</p>}
            {/* scaffold: press */}
            {pubLine && (
              <p class="portfolio-label mt-4">
                Published in{' '}
                {pub?.url ? (
                  <a class="portfolio-link text-foreground" href={pub.url} rel="noopener">
                    {pubLine}
                  </a>
                ) : (
                  <span class="text-foreground">{pubLine}</span>
                )}
              </p>
            )}
            {/* scaffold:end */}
            <p class="film__end-links">
              <button type="button" class="film__btn film__chip" data-film-again hidden>
                Watch again
              </button>
              <a class="portfolio-label portfolio-link" href="#story-made-heading">
                How this was made
              </a>
            </p>
          </div>
        </li>
      </ol>

      <div class="film__progress" data-film-progress aria-hidden="true" hidden></div>
      <div class="film__controls" data-film-controls hidden>
        <span class="film__count film__chip" data-film-count aria-hidden="true"></span>
        <span class="film__buttons">
          <button
            type="button"
            class="film__btn film__chip"
            data-film-prev
            aria-label="Previous frame"
          >
            <svg
              viewBox="0 0 20 20"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M12.5 4.5 7 10l5.5 5.5" />
            </svg>
          </button>
          <button type="button" class="film__btn film__chip" data-film-play>
            Pause
          </button>
          <button type="button" class="film__btn film__chip" data-film-next aria-label="Next frame">
            <svg
              viewBox="0 0 20 20"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M7.5 4.5 13 10l-5.5 5.5" />
            </svg>
          </button>
        </span>
      </div>
      <p class="sr-only" data-film-live aria-live="polite"></p>
    </section>

    <section
      class="story-made split mx-auto max-w-content px-m"
      aria-labelledby="story-made-heading"
    >
      <div>
        <h2 id="story-made-heading" class="portfolio-label mb-4">
          How this was made
        </h2>
        {made.length > 0 && (
          <dl class="credit-block">
            {made.map((row) => (
              <div>
                <dt class="portfolio-label">{row.label}</dt>
                <dd class="text-foreground">{row.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
      <div>
        <p class="story-made__ask font-display">Want a session like this?</p>
        <p class="mt-3 text-muted-foreground">
          Bring me a decade, a character or a story, and I will plan the rest with you.
        </p>
        <p class="mt-6">
          <CtaLink cta={{ label: 'Get in touch', href: '/contact/' }} variant="secondary" />
        </p>
      </div>
    </section>

    <nav class="story-next mx-auto max-w-content px-m" aria-label="More stories">
      {next && (
        <a href={`/stories/${next.slug}/`} class="story-next__link">
          <span class="story-next__text">
            <span class="portfolio-label block">Next story</span>
            <span class="story-next__title font-display">{next.title}</span>
            {next.dek && <span class="mt-3 block text-muted-foreground">{next.dek}</span>}
          </span>
          {next.cover && (
            <span class="story-next__cover">
              <FocusImage
                photo={next.cover}
                width={900}
                crop={4 / 5}
                sizes="(min-width: 48rem) 30vw, 60vw"
                alt=""
              />
            </span>
          )}
        </a>
      )}
      {prev && (
        <p class="mt-10">
          <a href={`/stories/${prev.slug}/`} class="portfolio-label portfolio-link">
            Previous story: {prev.title}
          </a>
        </p>
      )}
    </nav>
  </article>
</BaseLayout>

<script>
  import '@/scripts/story-film';
</script>
